@{
    TempData["Title"] = "Dịch vụ";  
    Layout = "~/Views/Shared/_LayoutNews.cshtml";
}

<script src="~/AppJs/newsHome.js"></script>
<div id="content" class="blog-wrapper blog-archive page-wrapper">
    <header class="archive-page-header">
        <div class="row">
            <div class="large-12 text-center col">
                <nav aria-label="breadcrumbs" class="rank-math-breadcrumb">
                    <p><a href="/">Home</a><span class="separator"> &raquo; </span><span class="last">Dịch vụ</span></p>
                </nav>
                <h1 class="page-title is-large uppercase">
                    <span>Dịch vụ</span>
                </h1>
            </div>
        </div>
    </header>
    <div class="row align-center">
        <div class="large-12 col">
            <div class="row large-columns-3 medium-columns- small-columns-1">
                @foreach (var item in Model)
                {
                    <div class="col post-item">
                        <div class="col-inner">
                            <a href="/dich-vu/@item.LinkSeo" class="plain">
                                <div class="box box-text-bottom box-blog-post has-hover">
                                    <div class="box-image">
                                        <div class="image-cover" style="padding-top:62%;">
                                            <img width="300" height="169" src="data:image/svg+xml,%3Csvg%20viewBox%3D%220%200%20300%20169%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3C%2Fsvg%3E" data-src="@item.Image"
                                                 class="lazy-load attachment-medium size-medium wp-post-image" alt="@item.MetaTitle" decoding="async" srcset="" data-srcset="@item.Image 300w, @item.Image 1024w, @item.Image 768w, @item.Image 1536w, @item.Image 1898w"
                                                 sizes="auto, (max-width: 300px) 100vw, 300px" />
                                        </div>
                                    </div>
                                    <div class="box-text text-left">
                                        <div class="box-text-inner blog-post-inner">
                                            <h5 class="post-title is-large ">@item.MetaTitle</h5>
                                            <div class="is-divider"></div>
                                            <p class="from_the_blog_excerpt ">@item.Description</p>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                }
            </div>
            <ul class="page-numbers nav-pagination links text-center">
                <li><span aria-current="page" class="page-number current">1</span></li>
                <li><a class="page-number" href="https://vuavesinh.vn/dich-vu/page/2/">2</a></li>
                <li><a class="page-number" href="https://vuavesinh.vn/dich-vu/page/3/">3</a></li>
                <li><a class="next page-number" href="https://vuavesinh.vn/dich-vu/page/2/"><i class="icon-angle-right"></i></a></li>
            </ul>
        </div>
    </div>
</div>
<script>
    let elment = document.getElementById('menu-item-9');
    elment.classList.add("active");
</script>

