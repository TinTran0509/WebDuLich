@using Web.Model.CustomModel
@{ 
    Layout = "~/Views/Shared/_LayoutList.cshtml";
    List<ProductModel> prodGroups = (List<ProductModel>)TempData["GroupTour"];
    List<ProductModel> prodPrivate = (List<ProductModel>)TempData["PrivateTour"];
    List<UserModel> userModels = (List<UserModel>)TempData["UserModel"];
    List<LocationViewModel> loactions = (List<LocationViewModel>)TempData["Locations"];
     
}
@model MenuTranModel
@if (Model != null)
{
    <input type="hidden" id="lang-code" value="@Model.LangCode" />
    <div class="page-banner">
        <picture>
            <source media="(max-width: 480px)" data-lazy-srcset="@Model.Image">
            <source media="(min-width: 481px)" data-lazy-srcset="@Model.Image">
            <img style="height:500px" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E"
                 alt="@Model.Title"
                 fetchpriority="high"
                 decoding="async"
                 class="banner-image"
                 data-lazy-src="@Model.Image" />
            <noscript>
                <img src="@Model.Image"
                     alt="@Model.Title"
                     fetchpriority="high"
                     decoding="async"
                     class="banner-image" />
            </noscript>
        </picture>
        <h1 class="banner-title">@Model.Title</h1>
        <ul class="oc-breadcrumbs">
            <li><a href="/" class="home">@ViewBag.HomePage</a></li>
            <li><span>@Model.Name</span></li>
        </ul>
    </div>

    <div class="bg-color-fffdfb bb-ddd pt-15 pb-15 position-sticky top-0 z-index-10 sm-d-none">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between gap-15">
                <div class="nav-scroll fw-700">
                    <a href="#overview" class="d-inline-block color-333 p-10-14 pl-0">
                        @ViewBag.Summary
                    </a>
                    <a href="#itinerary" class="d-inline-block color-333 p-10-14 text-decoration-none">
                        @ViewBag.Itinerary
                    </a>
                    <a href="#highlight" class="d-inline-block color-333 p-10-14 text-decoration-none">
                        @ViewBag.Highlights
                    </a>
                    <a href="#gallery" class="d-inline-block color-333 p-10-14 text-decoration-none">
                        @ViewBag.Gallery
                    </a>
                    <a href="#our_expert" class="d-inline-block color-333 p-10-14 text-decoration-none">
                        @ViewBag.OurExpert
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="bt-edeae5 bb-edeae5 pt-45 pb-50" id="overview">
        <div class="container">
            <div class="row">
                @Html.Raw(Model.Contents)
            </div>
        </div>
    </div>

    <div class="pt-60 sm-pt-30 pb-50 bt-edeae5 bb-edeae5" id="itinerary">
        <div class="container">
            <h2 class="section-title">
                @Html.Raw(ViewBag.GroupTrip)
            </h2>
            <div class="row">
                <!-- 9 item -->
                @foreach (var item in prodGroups)
                {
                    string star = "★";
                    for (int i = 1; i < item.NumberStar; i++)
                    {
                        star += "★";
                    }
                    int night = item.DayNumber - 1;
                    <div class="col-sm-6 col-lg-4 mb-30">
                        <div class="bg-color-fffdfb box-shadow-1 position-relative h-100 pb-115">
                            <div class="position-relative">
                                <a href="/tour/@item.LinkSeo">
                                    <img class="w-100"
                                         src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E"
                                         alt="@item.Title" data-lazy-src="@item.Image">
                                    <noscript>
                                        <img class="w-100"
                                             src="@item.Image"
                                             alt="@item.Title">
                                    </noscript>
                                </a>
                                <div class="position-absolute fw-700 color-fff text-shadow-1 left-20 bottom-18">
                                    @item.DayNumber @ViewBag.Days / @night @ViewBag.Nigths
                                </div>
                            </div>
                            <div class="pl-20 pr-20">
                                <h3 class="fsz-18 mt-18 mb-12">
                                    <a href="/tour/@item.LinkSeo" class="text-decoration-none">
                                        @item.Title
                                    </a>
                                </h3>
                                <div class="fw-500 color-bd1e2d">
                                    @item.Countries
                                </div>
                                <div>
                                    @item.Locations
                                </div>
                            </div>

                            <div class="position-absolute left-0 right-0 bottom-18 ml-20 mr-20">
                                <div class="fsz-18 color-ffa534 text-right">
                                    @star
                                </div>
                                <hr class="mt-10 mb-15">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <span>@ViewBag.Price</span>
                                        <span class="fsz-18 fw-700 color-111">
                                            USD @item.Price
                                        </span>
                                    </div>
                                    <div>
                                        <a href="/tour/@item.LinkSeo" class="d-inline-block">
                                            @ViewBag.Detail
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="text-center">
                <a href="#" class="btn-style">
                    @ViewBag.SeeMore
                </a>
            </div>
        </div>
    </div>

    <div class="pt-60 sm-pt-30 pb-50 bt-edeae5 bb-edeae5">
        <div class="container">
            <h2 class="section-title">
                @Html.Raw(ViewBag.CustomizedTrips)
            </h2>
            <div class="row">
                <!-- Lấy ra 3 -->
                @foreach (var item in prodPrivate)
                {
                    int night = item.DayNumber - 1;
                    <div class="col-sm-6 col-lg-4 mb-30">
                        <div class="bg-color-fffdfb box-shadow-1 position-relative h-100 pb-115">
                            <div class="position-relative">
                                <a href="/@item.LangCode.ToLower()/tour/@item.LinkSeo">
                                    <img class="w-100"
                                         src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E"
                                         alt="@item.Title" data-lazy-src="@item.Image">
                                    <noscript>
                                        <img class="w-100"
                                             src="@item.Image"
                                             alt="@item.Title">
                                    </noscript>
                                </a>
                                <div class="position-absolute fw-700 color-fff text-shadow-1 left-20 bottom-18">
                                    @item.DayNumber @ViewBag.Days / @night @ViewBag.Nigths
                                </div>
                            </div>
                            <div class="pl-20 pr-20">
                                <h3 class="fsz-18 mt-18 mb-12">
                                    <a href="/@item.LangCode.ToLower()/tour/@item.LinkSeo" class="text-decoration-none">
                                        @item.Title
                                    </a>
                                </h3>
                                <div class="fw-500 color-bd1e2d">
                                    @item.Countries
                                </div>
                                <div>
                                    @item.Locations
                                </div>
                            </div>
                            <div class="position-absolute left-0 right-0 bottom-18 ml-20 mr-20">
                                <div class="fsz-18 color-ffa534 text-right">
                                    ★★★★
                                </div>
                                <hr class="mt-10 mb-15">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <span>@ViewBag.Price</span>
                                        <span class="fsz-18 fw-700 color-111">
                                            USD @item.Price
                                        </span>
                                    </div>
                                    <div>
                                        <a href="/@item.LangCode.ToLower()/tour/@item.LinkSeo" class="d-inline-block">
                                            @ViewBag.Detail
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="text-center">
                <a href="" class="btn-style">
                    @ViewBag.SeeMore
                </a>
            </div>
        </div>
    </div>

    if (loactions.Any())
    {
        <div class="pt-45 pb-80 sm-pb-55 bt-edeae5 bb-edeae5 overflow-hidden" id="highlight">
            <div class="container">
                <div class="section-title text-center mt-0">
                    @Html.Raw(ViewBag.WhatSee)
                </div>
                <div class="destination-slider position-relative sm-ml--50pc sm-mr--50pc">
                    <div class="swiper" data-swiper='{"loop":"true","slidesPerView":"3","spaceBetween":"20","navigation": {"nextEl": ".destination-slider .swiper-button-next", "prevEl": ".destination-slider .swiper-button-prev"},"breakpoints":{"992":{"slidesPerView":"4","spaceBetween":"30"},}}'>
                        <div class="swiper-wrapper">
                            @foreach (var item in loactions)
                            {
                                <div class="swiper-slide h-auto p-1">
                                    <div class="h-100 bg-color-fffdfb box-shadow-1 position-relative pb-50">
                                        <img class="w-100" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E"
                                             alt="@item.Name" data-lazy-src="@item.Image"><noscript>
                                            <img class="w-100" src="@item.Image"
                                                 alt="@item.Name">
                                        </noscript>
                                        <div class="pl-20 pr-20">
                                            <h3 class="fsz-18 mt-18 mb-12">
                                                @item.Name
                                            </h3>
                                            <p>@item.Description</p>
                                            <div class="position-absolute left-20 bottom-30 w-35px border-bd1e2d"></div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="swiper-button-prev left--60"></div>
                    <div class="swiper-button-next right--60"></div>
                </div>
            </div>
        </div>
    }

    <div class="pt-45 pb-80 sm-pb-55 bt-edeae5 bb-edeae5" id="gallery">
        <div class="container">
            <div class="section-title text-center mt-0">
                @Html.Raw(ViewBag.Media)
            </div>

            <div class="row row-gap-30 md-row-gap-20 md-col-gap-20">
                <div class="col-md-6">
                    <div class="position-relative">
                        <a href="#"
                           data-fancybox="gallery" data-caption="Gran Muralla">
                            <img class="w-100" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E"
                                 alt="Gran Muralla" data-lazy-src="/Content/images/gallery/Ha-long.jpg"><noscript>
                                <img class="w-100" src="/Content/images/gallery/Ha-long.jpg"
                                     alt="Gran Muralla">
                            </noscript>
                            <p class="position-absolute left-20 md-left-15 bottom-15 text-shadow-1 fsz-18 fw-500 color-fff">
                                Ha long
                            </p>
                        </a>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row row-gap-30 md-row-gap-20 md-col-gap-20">
                        <div class="col-6">
                            <div class="position-relative">
                                <a href="#"
                                   data-fancybox="gallery" data-caption="Hangzhou">
                                    <img class="w-100" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E"
                                         alt="Hangzhou" data-lazy-src="/Content/images/gallery/9-4.jpg"><noscript>
                                        <img class="w-100" src="/Content/images/gallery/9-4.jpg"
                                             alt="Hangzhou">
                                    </noscript>
                                    <p class="position-absolute left-20 md-left-15 bottom-15 text-shadow-1 fsz-18 fw-500 color-fff">
                                        Hangzhou
                                    </p>
                                </a>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="position-relative">
                                <a href="#"
                                   data-fancybox="gallery" data-caption="Ciudad Prohibida Pequín">
                                    <img class="w-100" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E"
                                         alt="Ciudad Prohibida Pequín" data-lazy-src="/Content/images/gallery/angkor-wat-1.jpg"><noscript>
                                        <img class="w-100" src="/Content/images/gallery/angkor-wat-1.jpg"
                                             alt="Ciudad Prohibida Pequín">
                                    </noscript>
                                    <p class="position-absolute left-20 md-left-15 bottom-15 text-shadow-1 fsz-18 fw-500 color-fff">
                                        Angko
                                    </p>
                                </a>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="position-relative">
                                <a href="#"
                                   data-fancybox="gallery" data-caption="Lago del Oeste de Hangzhou">
                                    <img class="w-100" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E"
                                         alt="Lago del Oeste de Hangzhou" data-lazy-src="/Content/images/gallery/bai-dinh-16.jpg"><noscript>
                                        <img class="w-100" src="/Content/images/gallery/bai-dinh-16.jpg"
                                             alt="Lago del Oeste de Hangzhou">
                                    </noscript>
                                    <p class="position-absolute left-20 md-left-15 bottom-15 text-shadow-1 fsz-18 fw-500 color-fff">
                                        Demo
                                    </p>
                                </a>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="position-relative">
                                <a href="#~/Content/images/gallery/demo.jpg"
                                   data-fancybox="gallery" data-caption="Xi'an">
                                    <img class="w-100" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E"
                                         alt="Xi'an" data-lazy-src="/Content/images/gallery/demo.jpg"><noscript>
                                        <img class="w-100" src="/Content/images/gallery/demo.jpg"
                                             alt="Xi'an">
                                    </noscript>
                                    <p class="position-absolute left-20 md-left-15 bottom-15 text-shadow-1 fsz-18 fw-500 color-fff">
                                        Xi'an
                                    </p>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="pt-60 sm-pt-30 pb-15 bt-edeae5 bb-edeae5" id="our_expert">
        <div class="container">
            <div class="section-title">
                @Html.Raw(ViewBag.OurSpecialists)
            </div>
            <div class="row">
                @foreach (var item in userModels)
                {
                    <div class="col-6 col-md-3 mb-30">
                        <div class="mw-150 center-block text-center">
                            <img class="brs-50pc" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" alt="@item.FullName" data-lazy-src="@item.Photo">
                            <noscript>
                                <img class="brs-50pc" src="@item.Photo" alt="@item.FullName">
                            </noscript>
                            <h3 class="fsz-18 mt-18 mb-5">@item.FullName</h3>
                            <div>@item.Description</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

