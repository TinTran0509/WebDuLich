<div class="pt-60 sm-pt-50 pb-50 text-center" id="overview">
    <div class="container">
        @*<div class="mw-680 center-block">*@
        <div class="align-items-center">
            @Html.Raw(Model.Contents)
        </div>
        <div class="pt-60 sm-pt-50">
            <div class="tour-package"><hr /></div>
            <div>
                ID @ViewBag.ProductCode
            </div>
            <div class="fw-700 pt-5">
                @Model.ProductCode
            </div>
        </div>

        <div class="pt-30">
            <p>@ViewBag.Destination</p>
            <div class="fw-700">
                @Html.Raw(locations)
            </div>
        </div>
        <div class="mw-1000 center-block">
            <div class="row justify-content-center row-gap-30 pt-40">
                <div class="col-6 col-md-3 col-lg-20">
                    <div class="d-inline-block pb-5 bb-bd1e2d bw-2">
                        @ViewBag.Duration
                    </div>
                    <div class="fw-700 fsz-22 pt-10">
                        @Model.DayNumber @ViewBag.Days
                    </div>
                </div>
                <div class="col-6 col-md-3 col-lg-20">
                    <div class="d-inline-block pb-5 bb-bd1e2d bw-2">
                        @ViewBag.GuideLang
                    </div>
                    <div class="fw-700 fsz-22 pt-10">
                        @ViewBag.LangName
                    </div>
                </div>
                @*<div class="col-6 col-md-3 col-lg-20">
                    <div class="d-inline-block pb-5 bb-bd1e2d bw-2">
                        Hotel
                    </div>
                    <div class="fw-700 fsz-22 pt-10 color-ffa534 ls-02">
                        ★★★★★
                    </div>
                </div>*@
                <div class="col-6 col-md-3 col-lg-20">
                    <div class="d-inline-block pb-5 bb-bd1e2d bw-2">
                        @ViewBag.TourTypeDes
                    </div>
                    <div class="fw-700 fsz-22 pt-10">
                        @ViewBag.TourType
                    </div>
                </div>
                <div class="col-6 col-md-3 col-lg-20">
                    <div class="d-inline-block pb-5 bb-bd1e2d bw-2">
                        @ViewBag.AverageSize
                    </div>
                    <div class="fw-700 fsz-22 pt-10">@Model.Size</div>
                </div>

                @*<div class="col-6 col-md-3 col-lg-20">
                        <div class="d-inline-block pb-5 bb-bd1e2d bw-2">
                            @ViewBag.Price
                        </div>
                        <div class="fw-700 fsz-22 pt-10">
                            USD @Model.Price
                        </div>
                    </div>*@
            </div>
        </div>
        <div class="text-center pt-40">
            <a href="#" class="btn-style">
                @ViewBag.SelectDate
            </a>
        </div>
    </div>
</div>

<div class="pt-45 bt-edeae5 overflow-hidden" id="highlight">
    <div class="container">
        <h2 class="section-title text-center mt-0">
            <span>
                @ViewBag.Destination
            </span>
        </h2>
        <div class="destination-slider position-relative sm-ml--50pc sm-mr--50pc">
            <div class="swiper" data-swiper='{"loop":"true","slidesPerView":"3","spaceBetween":"20","navigation": {"nextEl": ".destination-slider .swiper-button-next", "prevEl": ".destination-slider .swiper-button-prev"},"breakpoints":{"992":{"slidesPerView":"4","spaceBetween":"30"},}}'>
                <div class="swiper-wrapper">
                    @foreach (var item in locationTrans)
                    {
                        <div class="swiper-slide h-auto p-1">
                            <div class="h-100 bg-color-fffdfb box-shadow-1 position-relative pb-50">
                                <img class="w-100" src="@item.Image" alt="Kanazawa" data-lazy-src="@item.Image"><noscript><img class="w-100" src="@item.Image" alt="@item.Name"></noscript>
                                <div class="pl-20 pr-20">
                                    <h3 class="fsz-18 mt-18 mb-12">
                                        @item.Name
                                    </h3>
                                    <p>
                                        @item.Description
                                    </p>
                                    <div class="position-absolute left-20 bottom-30 w-35px border-bd1e2d"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="swiper-button-prev left--60"></div>
            <div class="swiper-button-next right--60"></div>
        </div>
    </div>
</div>

<div class="pt-45" id="itinerary">
    <div class="container">

    </div>

    <div class="pt-30">
        <h2 class="section-title fw-400 text-center">
            @Html.Raw(ViewBag.EstimatedPrice)
        </h2>
    </div>
    <div class="pt-50 text-center">
        <a href="/booking-tour?tour_id=@Model.ID" class="btn-style btn-redirect-booking">
            @ViewBag.YeuCauBaoGia
        </a>
    </div>
</div>

<div class="pt-60 sm-pt-30 pb-50 sm-pb-25 bt-edeae5 bb-edeae5">
    <div class="container">
        <h2 class="section-title">
            <span>
                @ViewBag.ThemLichTrinh
            </span>
        </h2>
        <div class="row">
            @foreach (var item in relates)
            {
                //string starMore = "★";
                //for (int i = 1; i < item.NumberStar; i++)
                //{
                //    starMore += "★";
                //}
                int night = item.DayNumber - 1;
                <div class="col-sm-6 col-lg-4 mb-30">
                    <div class="bg-color-fffdfb box-shadow-1 position-relative h-100 pb-115">
                        <div class="position-relative">
                            <a href="/tour/@item.LinkSeo">
                                <img class="w-100"
                                     src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E"
                                     alt="@item.Title" data-lazy-src="@item.Image"><noscript>
                                    <img class="w-100"
                                         src="@item.Image"
                                         alt="@item.Title">
                                </noscript>
                            </a>
                            <div class="position-absolute fw-700 color-fff text-shadow-1 left-20 bottom-18">
                                @item.DayNumber @ViewBag.Days / @night @ViewBag.Nigths
                            </div>
                        </div>
                        <div class="pl-20 pr-20">
                            <h3 class="fsz-18 mt-18 mb-12">
                                <a href="/tour/@item.LinkSeo" class="text-decoration-none">
                                    @item.Title
                                </a>
                            </h3>
                            <div class="fw-500 color-bd1e2d">
                                @item.Countries
                            </div>
                            <div>
                                @item.Locations
                            </div>
                        </div>
                        <div class="position-absolute left-0 right-0 bottom-18 ml-20 mr-20">
                            @*<div class="fsz-18 color-ffa534 text-right">
                                @starMore
                            </div>*@
                            <hr class="mt-10 mb-15">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <span>@ViewBag.From</span>
                                    <span class="fsz-18 fw-700 color-111">
                                        USD @item.Price
                                    </span>
                                </div>
                                <div>
                                    <a href="/tour/@item.LinkSeo" class="d-inline-block">
                                        @ViewBag.Detail
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>



