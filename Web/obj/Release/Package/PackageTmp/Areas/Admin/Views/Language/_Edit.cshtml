@using Web.Model
@model tbl_Languages
@using (Ajax.BeginForm("Edit", "Language", null,
                new AjaxOptions
                {
                    HttpMethod = "POST",
                    OnSuccess = "Language.onAddSuccess"
                },
                new { @id = "basicForm", @class = "form-horizontal" }))
{
    @Html.HiddenFor(x => x.ID)
    @Html.HiddenFor(x => x.LangCode)
    <div class="form-group">
        <label class="col-md-2 control-label">Mã</label>
        <div class="col-md-6">
            @Html.TextBoxFor(g => g.FullCode, new { @class = "form-control", placeholder = "Mã", @readonly = "readonly" })
        </div>
    </div>
    <div class="form-group">
        <label class="col-md-2 control-label">Tên</label>
        <div class="col-md-6">
            @Html.TextBoxFor(g => g.LangName, new { @class = "form-control", placeholder = "Tên" })
        </div>
    </div>
    <div class="form-group">
        <label class="control-label col-md-2">Quốc kỳ</label>
        <div class="col-md-10">
            <div class="col-md-2">
                @{ Html.RenderAction("UploadImage", "UploadFile", new { controlName = "Icon" });}
            </div>
            <img src="@Model.Icon" style="width:100px" id="prevImages">
            <span class="error" id="spImg"></span>
        </div>
    </div>
    <div class="form-group">
        <label class="col-md-2 control-label">Thứ tự hiển thị</label>
        <div class="col-md-1 lockChar">
            @Html.TextBoxFor(g => g.Ordering, new { @class = "form-control", @type = "number", @min = "1" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-sm-10 pull-right">
            <div class="checkbox checkbox-primary">
                <input id="Active" name="Active" type="checkbox" @(Model.Active ? "checked=''" : "") value="true">
                <label for="Active">
                    Active
                </label>
            </div>
        </div>
    </div>
    <div class="form-group">
        <div class="col-sm-10 pull-right">
            <div class="checkbox checkbox-primary">
                <input id="Active" name="IsDefault" type="checkbox" @(Model.IsDefault ? "checked=''" : "") value="true">
                <label for="IsDefault">
                    Hiển thị mặc định
                </label>
            </div>
        </div>
    </div>
    <div class="text-center">
        <button type="submit" class="btn btn-primary waves-effect waves-light">Cập nhật</button>
    </div>
}
<script>
    // Basic Form
    $(document).ready(function () {
        $('.lockChar').on("keypress", function (event) {
            return event.charCode >= 48 && event.charCode <= 57
        })
    });
</script>