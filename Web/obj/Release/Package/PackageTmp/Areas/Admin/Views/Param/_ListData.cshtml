 
@model List<Web.Model.Param>
<table class="table table-striped cabn_datatable">
        <thead>
            <tr>
                <th>
                    <input type="hidden" id="hdfID" />
                    <div class="checkbox">
                        <input id="chkall" type="checkbox">
                        <label for="chkall"></label>
                    </div>
                </th>
                <th>Tên tham số</th>
                <th>Giá trị</th> 
                <th>Mô tả</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="vertical-align: middle;">
                        <div class="checkbox">
                            <input type="checkbox" value="@item.ID" id="chk'@item.ID'">
                            <label for="chk'@item.ID'"></label>
                        </div>
                    </td>
                    <td style="vertical-align: middle;">@item.KeyName</td>
                    <td style="vertical-align: middle;">@item.Value</td>
                    <td style="vertical-align: middle;">@item.Description</td>
                    <td>
                        <div class="btn-list pull-right mr5">
                            <a href="#" class="btn btn-primary btn-bordered" onclick="Param.loadfrmEdit(@item.ID) "><i class="glyphicon glyphicon-pencil"></i></a> 
                            <a href="#" class="btn btn-danger btn-bordered" onclick="Param.ondelete(@item.ID) ">
                                <i class="glyphicon glyphicon-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
<script>
    $(document).ready(function () { 
        InitClickCheckAllInTable("chkall", function(res) {
            $("#hdfID").val(res);
        });
        $('.cabn_datatable').dataTable(
            {
                "oLanguage": {
                    "sUrl": "/Content/Vietnamese.json"
                },
            }
        );
    });
</script>
