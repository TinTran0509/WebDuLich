@{
    var lstAction = (List<int>)HttpContext.Current.Session["Action"];
}
@using Web.Model.CustomModel
@model List<Web.Model.Topic>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Chủ đề</th>
            <th>Hình ảnh</th> 
            <th>Trạng thái</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        { 
            <tr>
                <td style="vertical-align: middle;">
                    @item.Title
                </td>
                <td> <img src="@item.Image" style="width: 50px;" /></td> 
                <td style="">@Html.Raw((bool)item.Active ? "<span style='color:green'>Hoạt động</span>" : "<span style='color:red'>Vô hiệu</span>")</td>
                <td>
                    <div class="btn-list pull-right mr5">
                        <a href="/Admin/Topic/AddTrans/@item.ID" class="btn btn-info btn-bordered" title="Thêm bản dịch">
                            <i class="fa fa-plus"></i>
                        </a>
                        <a href="#" class="btn btn-primary btn-bordered" onclick="Topic.loadfrmTopicTrans(@item.ID) " title="Bản dịch">
                            <i class="fa fa-language"></i>
                        </a>
                        @if (lstAction != null && lstAction.Contains((int)EnumHelper.Action.Edit))
                        {
                            <a href="#" class="btn btn-primary btn-bordered" onclick="Topic.loadfrmEdit(@item.ID) " title="Sửa">
                                <i class="glyphicon glyphicon-pencil"></i>
                            </a>
                        }
                        @if (lstAction != null && lstAction.Contains((int)EnumHelper.Action.Delete))
                        {
                            <a href="#" class="btn btn-danger btn-bordered" onclick="Topic.ondelete(@item.ID) " title="Xóa">
                                <i class="glyphicon glyphicon-trash"></i>
                            </a>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
    $(document).ready(function () {
        $('.width50').on("keypress", function () {
            return event.charCode >= 48 && event.charCode <= 57
        })
        InitClickCheckAllInTable("chkall", function (res) {
            $("#hdfID").val(res);
        });
    });
</script>
