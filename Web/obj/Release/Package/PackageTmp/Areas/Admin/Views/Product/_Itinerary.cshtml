
<style> 
    .day-item {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 10px;
        margin-bottom: 20px;
    }

    .language-tabs {
        display: flex;
        gap: 5px;
        margin-bottom: 10px;
    }

    .lang-tab {
        border: 1px solid #ddd;
        background: #f5f5f5;
        padding: 8px 15px;
        border-radius: 5px;
        cursor: pointer;
    }

    .lang-tab.active {
        background: #1976d2;
        color: white;
        border-color: #1976d2;
    }

    .day-header { 
        justify-content: space-between;
        align-items: center;
    }

    .btn-delete-day {
        float: right;
        background: #dc3545;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 5px;
        cursor: pointer;
    }

    .btn-delete-day:hover {
        background: #bb2d3b;
    }

    .destination {
        margin-bottom: 5px
    }
</style>
@using Web.Model
@model Product
@using (Ajax.BeginForm("AddItinerary", "Product", null,
    new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "saveSuccess"
    },
    new { @id = "frmData", @class = "form-horizontal" }))
{
    <input type="hidden" name="Itineraries" id="Itineraries" />
    @Html.HiddenFor(x => x.ID)
    <div class="form-group">
        <label class="col-md-1 control-label">Bản đồ</label>
        <div class="col-md-10">
            <div class="col-md-2">
                @{ Html.RenderAction("UploadImage", "UploadFile", new { controlName = "ImageItinerary" });}
            </div>
            <img style="width:150px" src="@Model.ImageItinerary" id="prevImages">
            <span class="error" id="spImg"></span>
        </div>
    </div>
    <div id="days"></div>
    <button type="button" class="btn btn-primary waves-effect waves-light" onclick="addDay()">
        <i class="glyphicon glyphicon-plus"></i>&nbsp;Thêm ngày
    </button>
    <div class="form-group">
        <div class="text-center">
            <button onclick="getData()" type="button" class="btn btn-primary waves-effect waves-light">Lưu lại</button>
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
        </div>
    </div>
    <input type="hidden" value="@Model.Itineraries" id="itineraryData" />
    <input type="hidden" id="ItineraryData" name="ItineraryData" />
}

<script>
    let days = [];
    let dayIndex = 0;
    const languages = [
        {
            code: 'en',
            name: 'English'
        },
        {
            code: 'es',
            name: 'Español'
        }
    ];
    function addDay() {
        /*<button type="button" class="btn btn-delete-day" onclick="removeDay(${dayId})">Xóa ngày</button>*/
        dayIndex++;
        const dayId = dayIndex;
        const day = document.createElement('div');
        day.className = 'day-item';
        day.dataset.day = dayId;
        day.innerHTML =
            `<div class="day-header">
                <label>Ngày ${dayId}</label> 
            </div>
            <div class="language-tabs">
            ${languages.map(lang => `
                <button type="button" class="btn lang-tab ${lang.code === 'en' ? 'active' : ''}" data-lang="${lang.code}">${lang.name}</button>`).join('')}
        </div>
        <input type="text" id="day-${dayId}" class="form-control destination" placeholder = "Ngày ${dayId}:..."/>
        <textarea id="editor-${dayId}"></textarea>`;

        document.getElementById('days').appendChild(day);

        // Data của ngày
        const dayData = {
            day: dayId,
            currentLanguage: 'en',
            title: {
                en: '',
                es: ''
            },
            contents: {
                en: '',
                es: ''
            },
            editor: null
        };

        days.push(dayData);

        // Tạo CKEditor
        ClassicEditor.create(document.getElementById(`editor-${dayId}`), {
            toolbar: [
                'heading',
                '|',
                'bold',
                'italic',
                'underline',
                'link',
                'bulletedList',
                'numberedList',
                '|',
                'blockQuote',
                'insertTable',
                'undo',
                'redo'
            ]
        }).then(function (editor) {
            dayData.editor = editor;
            setupLanguageTabs(day, dayData);
        }).catch(function (error) {
            console.error(error);
        });
    }

    function setupLanguageTabs(dayElement, dayData) {
        const tabs = dayElement.querySelectorAll('.lang-tab');
        const input = dayElement.querySelector('.destination');
        tabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
                // Lưu input của language hiện tại
                dayData.title[dayData.currentLanguage] = input.value;
                // Lưu CKEditor hiện tại
                dayData.contents[dayData.currentLanguage] = dayData.editor.getData();
                // Language mới
                const newLanguage = this.dataset.lang;
                dayData.currentLanguage = newLanguage;
                // Load input của language mới
                input.value = dayData.title[newLanguage] || '';
                // Load CKEditor của language mới
                dayData.editor.setData(
                    dayData.contents[newLanguage] || ''
                );
                tabs.forEach(function (item) {
                    item.classList.remove('active');
                });
                this.classList.add('active');
            });
        });
    }

    function removeDay(dayId) {
        if (!confirm('Bạn có chắc muốn xóa ngày này?')) {
            return;
        }
        const index = days.findIndex(x => x.day === dayId);
        if (index === -1) {
            return;
        }
        const dayData = days[index];
        if (dayData.editor) {
            dayData.editor.destroy()
                .then(function () { 
                    console.log('Editor destroyed:', dayId); 
                })
                .catch(function (error) { 
                    console.error(error); 
                });
        }
        const dayElement = document.querySelector(`[data-day="${dayId}"]`);

        if (dayElement) {
            dayIndex = dayIndex - 1;
            dayElement.remove();
        }

        days.splice(index, 1);
    }

    function getData() { 
        days.forEach(function (day) {
            const input = document.querySelector(`[data-day="${day.day}"] .destination`); 
            // Lưu language hiện tại
            if (input.value !== '') {
                day.title[day.currentLanguage] = input.value;
                day.contents[day.currentLanguage] = day.editor.getData();
            } 
        });

        const result = days.map(function (day, index) {
            return {
                day: index + 1,
                title: {
                    en: day.title.en,
                    es: day.title.es
                },
                content: {
                    en: day.contents.en,
                    es: day.contents.es
                }
            };
        });
        let Itineraries = [];
        const languages = ['en', 'es'];

        for (var i = 0; i < languages.length; i++) {
            result.map(item => (
                Itineraries.push(
                 { 
                    Title: item.title[languages[i]],
                    Contents: item.content[languages[i]],
                    LangCode: languages[i],
                    ProductID: $('#ID').val()
                  }
                )
               )
            );
        }
        $('#ItineraryData').val(JSON.stringify(Itineraries));
        $('#Itineraries').val(JSON.stringify(result));
        $('#frmData').submit();
    }

    function saveSuccess(res) {
        if (res.IsSuccess == true) {
            alertmsg.success(res.Messenger);
            modal.hide();
        } else {
            alertmsg.error(res.Messenger);
        }
    } 
 
    const itinerariesData = $('#itineraryData').val(); 
    if (itinerariesData != '') {
        const data = JSON.parse(itinerariesData); 
        loadDays(data);
    } 

    function loadDays(data) {
        for (const item of data) {
             addDayFromData(item);
        } 
    }

    function addDayFromData(data) {
    dayIndex++;
    const dayId = dayIndex;
    const day = document.createElement('div');
    day.className = 'day-item';
    day.dataset.day = dayId;
    day.innerHTML = `<div class="day-header">
            <label>Ngày ${dayId}</label> 
        </div>
        <div class="language-tabs">
            ${languages.map(lang => `
                <button type="button" class="btn lang-tab ${lang.code === 'en' ? 'active' : ''}"
                    data-lang="${lang.code}">
                    ${lang.name}

            </button >`).join('')}
        </div>
        <input type="text" id="day-${dayId}" class="form-control destination" /> 
        <textarea id="editor-${dayId}"></textarea>`;

    document.getElementById('days').appendChild(day);


    const dayData = {
        day: dayId,
        currentLanguage: 'en',
        title: { 
            en: data.title?.en || '',
            es: data.title?.es || ''
        },
        contents: { 
            en: data.content?.en || '',
            es: data.content?.es || ''
        },
        editor: null
    };

    days.push(dayData);

    return ClassicEditor
        .create(document.getElementById(`editor-${dayId}`), {
            toolbar: [
                'heading',
                '|',
                'bold',
                'italic',
                'underline',
                'link',
                'bulletedList',
                'numberedList',
                '|',
                'blockQuote',
                'insertTable',
                'undo',
                'redo'
            ]
        })
        .then(function (editor) {
            dayData.editor = editor;
            setupLanguageTabs(day,dayData);
            // Đổ language mặc định
            loadLanguage(day,dayData,'en');
        });
     }

    function loadLanguage(dayElement, dayData, language) { 
        const input = dayElement.querySelector('.destination'); 
        input.value = dayData.title[language] || '';
         
        dayData.editor.setData(
            dayData.contents[language] || ''
        ); 

        dayElement.querySelectorAll('.lang-tab')
            .forEach(function (tab) {
                tab.classList.toggle(
                    'active',
                    tab.dataset.lang === language
                );
            });  
            dayData.currentLanguage = language; 
     } 
</script>