@{
    var lstAction = (List<int>)HttpContext.Current.Session["Action"];
    int id = 0, bannerID = 0;
}
@using Web.Core
@using Web.Model.CustomModel
@model List<BannerModel>
    <table class="table">
        <thead>
            <tr>
                <th>Hình ảnh</th>
                <th>Tiêu đề</th>
                <th>Mô tả</th>
                <th>Nội dung</th>
                <th>Ngôn ngữ</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                string group = "group-banner";
                if(bannerID != item.BannerID)
                {
                    group = "";
                }
                <tr class="@group">
                    <td><img src="@item.Image" style="width: 50px;" /></td>
                    <td>@item.Title</td>
                    <td>@item.Description</td>
                    <td>@HelperString.TruncateByWord(HelperString.StripHTML(HttpUtility.HtmlDecode(item.Contents)), 110)</td>
                    <td>@item.LangName</td>

                    @if (id != item.BannerID)
                    {
                        <td rowspan="2">
                            <div class="btn-list pull-right mr5">
                                @if (lstAction != null && lstAction.Contains((int)EnumHelper.Action.Edit))
                                {
                                    <a href="/admin/banner/edit?id=@item.BannerID" class="btn btn-primary btn-bordered" title="Sửa">
                                        <i class="glyphicon glyphicon-pencil"></i>
                                    </a>
                                }
                                @if (lstAction != null && lstAction.Contains((int)EnumHelper.Action.Delete))
                                {
                                    <a href="#" class="btn btn-danger btn-bordered" onclick="Banner.ondelete(@item.ID) " title="Xóa">
                                        <i class="glyphicon glyphicon-trash"></i>
                                    </a>
                                }
                            </div>
                        </td>
                     }     
                    </tr>
                id = item.ID;
                bannerID = item.BannerID;
            }
        </tbody>
    </table>
    <script>
        $(document).ready(function () {
            $('.width50').on("keypress", function () {
                return event.charCode >= 48 && event.charCode <= 57
            })
            InitClickCheckAllInTable("chkall", function (res) {
                $("#hdfID").val(res);
            });
        });
    </script>
