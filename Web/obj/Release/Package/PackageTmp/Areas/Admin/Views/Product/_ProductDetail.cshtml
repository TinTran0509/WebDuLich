<script src="~/Content/plugins/ckeditor5/ckeditor.js"></script>
<script>
    function getValueTopic(ckb) {
        $('#MenuID').val(ckb);
    }
    $(document).ready(function () {
        $('.package-price').on("keypress", function (event) {
            return event.charCode >= 48 && event.charCode <= 57
        });
        $('html, body').animate({ scrollTop: 0 }, 1000);
        $('#CountryID').val(@Model.CountryID);
        $('#Type').val(@Model.Type);
        $('input[name="language"][value="@Model.MenuID"]').prop('checked', true);
        $('#Title').on('change', function () {
            let link = $('#Title').val();
            let linkSeo = RemoveMarkStr(link);
            $('#LinkSeo').val(linkSeo);
        });

        var countries = '@ViewBag.SelectedCountries'.split(';');
        $('input[name="country"]').prop('checked', function () {
            return countries.includes(this.value);
        });

        var locations = '@ViewBag.SelectedLocation'.split(';');
        $('#LocationIDs').val(locations).trigger('change');
    });
</script>
<script>
    let days = [];
    let dayIndex = 0;
    const languages = [
        {
            code: 'en',
            name: 'English'
        },
        {
            code: 'es',
            name: 'Spain'
        }
    ];


    function setupLanguageTabs(dayElement, dayData) {
        const tabs = dayElement.querySelectorAll('.lang-tab');
        const input = dayElement.querySelector('.destination');
        tabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
                // Lưu input của language hiện tại
                dayData.title[dayData.currentLanguage] = input.value;
                // Lưu CKEditor hiện tại
                dayData.contents[dayData.currentLanguage] = dayData.editor.getData();
                // Language mới
                const newLanguage = this.dataset.lang;
                dayData.currentLanguage = newLanguage;
                // Load input của language mới
                input.value = dayData.title[newLanguage] || '';
                // Load CKEditor của language mới
                dayData.editor.setData(
                    dayData.contents[newLanguage] || ''
                );
                tabs.forEach(function (item) {
                    item.classList.remove('active');
                });
                this.classList.add('active');
            });
        });
    }

    const editors = {};

    function initEditors() {
        const promises = [];
        document.querySelectorAll('.content-note')
            .forEach(function (textarea) {
                const type = textarea.dataset.type;
                const lang = textarea.dataset.lang;
                if (!editors[type]) {
                    editors[type] = {};
                }
                const promise = ClassicEditor
                    .create(textarea, {
                        toolbar: [
                            'heading',
                            '|',
                            'bold',
                            'italic',
                            'underline',
                            'link',
                            'bulletedList',
                            'numberedList',
                            '|',
                            'blockQuote',
                            'insertTable',
                            'undo',
                            'redo'
                        ]
                    })
                    .then(function (editor) {
                        editors[type][lang] = editor;
                        textarea.disabled = true;
                        editor.enableReadOnlyMode('lock');
                    });
                promises.push(promise);
            });
        return Promise.all(promises);
    }

    initEditors().then(function () {
        var _importantNotes = $('#ImportantNotes').val();
        if (_importantNotes !== '') {
            var ImportantNoteData = JSON.parse(_importantNotes);
            let incEn = ImportantNoteData.find(x => x.KeyNote == 'INCLUDED' && x.LangCode == 'EN');
            editors.included.en.setData(incEn != null ? incEn.Contents : '');
            let incEs = ImportantNoteData.find(x => x.KeyNote == 'INCLUDED' && x.LangCode == 'ES');
            editors.included.es.setData(incEs != null ? incEs.Contents : '');

            let excEn = ImportantNoteData.find(x => x.KeyNote == 'EXCLUDED' && x.LangCode == 'EN');
            editors.excluded.en.setData(excEn != null ? excEn.Contents : '');
            let excEs = ImportantNoteData.find(x => x.KeyNote == 'EXCLUDED' && x.LangCode == 'ES');
            editors.excluded.es.setData(excEs != null ? excEs.Contents : '');

            let impEn = ImportantNoteData.find(x => x.KeyNote == 'IMPORTANT' && x.LangCode == 'EN');
            editors.important.en.setData(impEn != null ? impEn.Contents : '');
            let impEs = ImportantNoteData.find(x => x.KeyNote == 'IMPORTANT' && x.LangCode == 'ES');
            editors.important.es.setData(impEs != null ? impEs.Contents : '');

            let higEn = ImportantNoteData.find(x => x.KeyNote == 'HIGHLIGHTS' && x.LangCode == 'EN');
            editors.highlights.en.setData(higEn != null ? higEn.Contents : '');
            let higEs = ImportantNoteData.find(x => x.KeyNote == 'HIGHLIGHTS' && x.LangCode == 'ES')
            editors.highlights.es.setData(higEs != null ? higEs.Contents : '');
        }
    });

    const itinerariesData = $('#itineraryData').val();
    if (itinerariesData != '') {
        const data = JSON.parse(itinerariesData);
        loadDays(data);
    }

    function loadDays(data) {
        for (const item of data) {
            addDayFromData(item);
        }
    }

    function addDayFromData(data) {
        dayIndex++;
        const dayId = dayIndex;
        const day = document.createElement('div');
        day.className = 'day-item';
        day.dataset.day = dayId;
        day.innerHTML = `<div class="day-header">
            <label>Ngày ${dayId}</label>
        </div>
        <div class="language-tabs">
            ${languages.map(lang => `
                <button type="button" class="btn lang-tab ${lang.code === 'en' ? 'active' : ''}"
                    data-lang="${lang.code}">
                    ${lang.name}

            </button >`).join('')}
        </div>
        <input type="text" id="day-${dayId}" class="form-control destination" disabled/>
        <textarea id="editor-${dayId}" disabled="disabled"></textarea>`;

        document.getElementById('days').appendChild(day);


        const dayData = {
            day: dayId,
            currentLanguage: 'en',
            title: {
                en: data.title?.en || '',
                es: data.title?.es || ''
            },
            contents: {
                en: data.content?.en || '',
                es: data.content?.es || ''
            },
            editor: null
        };

        days.push(dayData);

        return ClassicEditor
            .create(document.getElementById(`editor-${dayId}`), {
                toolbar: [
                    'heading',
                    '|',
                    'bold',
                    'italic',
                    'underline',
                    'link',
                    'bulletedList',
                    'numberedList',
                    '|',
                    'blockQuote',
                    'insertTable',
                    'undo',
                    'redo'
                ]
            })
            .then(function (editor) {
                dayData.editor = editor;
                editor.enableReadOnlyMode('lock');
                setupLanguageTabs(day, dayData);
                // Đổ language mặc định
                loadLanguage(day, dayData, 'en');
            });
    }

    function loadLanguage(dayElement, dayData, language) {
        const input = dayElement.querySelector('.destination');
        input.value = dayData.title[language] || '';

        dayData.editor.setData(
            dayData.contents[language] || ''
        );

        dayElement.querySelectorAll('.lang-tab')
            .forEach(function (tab) {
                tab.classList.toggle(
                    'active',
                    tab.dataset.lang === language
                );
            });
        dayData.currentLanguage = language;
    }
</script>