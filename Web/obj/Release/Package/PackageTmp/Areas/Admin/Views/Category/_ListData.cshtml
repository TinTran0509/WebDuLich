@{
    var lstAction = (List<int>)HttpContext.Current.Session["Action"];
    int id = 0, bannerID = 0;  
}
@using Web.Model.CustomModel
@model List<CategoryModel>
<table class="table">
    <thead>
        <tr>
            <th>Tên danh mục</th>
            <th>Thứ tự</th>
            <th>Ngôn ngữ</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            string group = "group-banner";
            if (bannerID != item.CategoryID)
            {
                group = "";
            }
            <tr class="@group">
                <td style="vertical-align: middle;">@item.Name</td>
                @if (id != item.CategoryID)
                {
                    <td rowspan="2" style="vertical-align: middle;">@item.Ordering</td>
                } 
                <td style="vertical-align: middle;">@item.LangName</td>
                @if (id != item.CategoryID)
                {
                    <td rowspan="2" style="vertical-align: middle;">
                        <div class="btn-list pull-right mr5">
                            @if (lstAction != null && lstAction.Contains((int)EnumHelper.Action.Edit))
                            {
                                <a href="/admin/category/edit/@item.ID" class="btn btn-primary btn-bordered"><i class="glyphicon glyphicon-pencil"></i></a>
                            }
                            @if (lstAction != null && lstAction.Contains((int)EnumHelper.Action.Delete))
                            {
                                <a href="#" class="btn btn-danger btn-bordered" onclick="Category.ondelete(@item.ID) ">
                                    <i class="glyphicon glyphicon-trash"></i>
                                </a>
                            }
                        </div>
                    </td>
                }
            </tr>
            id = item.ID;
            bannerID = (int)item.CategoryID;
        }
    </tbody>
</table>
<script>
    $(document).ready(function() {
        InitClickCheckAllInTable("chkall", function(res) {
            $("#hdfID").val(res);
        });
        $('.cabn_datatable').dataTable(
            {
                "oLanguage": {
                    "sUrl": "/Content/Vietnamese.json"
                },
            }
        );
        $('.lockchar').on("keypress", function (e) {
            return e.charCode >= 48 && e.charCode <= 57
        })
    });
</script>
