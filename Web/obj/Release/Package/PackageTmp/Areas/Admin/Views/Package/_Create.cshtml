@using Web
@using Web.Model
@model Package
@using (Ajax.BeginForm("Add", "Package", null,
    new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Package.onAddSuccess"
    },
    new { @id = "basicForm", @class = "form-horizontal" }))
{ 
    <div class="form-group">
        <label class="col-md-2 control-label">Tên gói <span class="asterisk">(*)</span></label>
        <div class="col-md-10">
            @Html.TextBoxFor(g => g.Name, new { @class = "form-control"})
        </div>
    </div> 
    <div class="form-group">
        <label class="col-md-2 control-label">Thứ tự</label>
        <div class="col-md-2 lockChar">
            @Html.TextBoxFor(g => g.Ordering, new { @class = "form-control", Value = 1,@type="number" })
        </div>
    </div> 
    <div class="text-center">
        <button type="submit" class="btn btn-primary waves-effect waves-light">Thêm mới</button>
    </div>
}
<script>
    // Basic Form
    $(document).ready(function () {
        $('.lockChar').on("keypress", function (event) {
            return event.charCode >= 48 && event.charCode <= 57
        })
        $("#basicForm").validate({
            rules:
            {
                Name:
                {
                    required: true
                },
                Ordering:
                {
                    required: true
                }
            },
            messages:
            {
                Name:
                {
                    required: "Chưa nhập tên gói"
                },
                Ordering:
                {
                    required: "Thứ tự không để trống"
                }
            }
        });
      
    }); 
</script>