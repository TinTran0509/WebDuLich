@{
    ViewBag.Title = "Quản lý hỗ trợ viên";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml"; 
}
@using Web.Model

<script src="~/AppJs/user.js"></script>
<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Người hỗ trợ</h3>
                <div style="top: 8px;position: absolute; right: 40px;" class="pull-right">
                    <button type="button" class="btn btn-primary waves-effect waves-light" onclick="User.loadfrmAdd() "><i class="fa fa-plus"></i> Thêm mới</button>
                    @*<button type="button" class="btn btn-danger waves-effect waves-light" onclick="User.onmultidelete() "><i class="fa fa-trash-o"></i> Xóa nhiều</button>*@
                </div>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <div class="table-responsive" id="gridData">

                        </div>
                        <div class="col-md-12" id="paginationholder">
                            <ul id="pagination" class="pagination"></ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        User.loadData();
    });
</script>