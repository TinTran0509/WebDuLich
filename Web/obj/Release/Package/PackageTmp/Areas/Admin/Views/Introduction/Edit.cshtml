@using Web.Model
@{
    ViewBag.Title = "Sửa lời tựa";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var languages = (List<tbl_Languages>)TempData["Languages"];
}
<style>
    .check-radio {
        display: inline-flex;
        align-items: center;
        cursor: pointer;
        margin-right: 20px;
        padding-top: 5px;
    }

        .check-radio input {
            display: none;
        }

        .check-radio span {
            position: relative;
            padding-left: 28px;
            font-weight: 500;
        }

            .check-radio span::before {
                content: "";
                position: absolute;
                left: 0;
                top: 50%;
                transform: translateY(-50%);
                width: 18px;
                height: 18px;
                border: 1px solid #999;
                border-radius: 3px; /* ô vuông giống checkbox */
                background: #fff;
            }

        .check-radio input:checked + span::before {
            background: #007bff;
            border-color: #007bff;
        }

        .check-radio input:checked + span::after {
            content: "✓";
            position: absolute;
            left: 4px;
            top: 50%;
            transform: translateY(-55%);
            color: white;
            font-size: 13px;
            font-weight: bold;
        }
    .del-video {  
        margin-left: 5px;
        font-size: 20px;
        color: red
    }
</style>
@model  Web.Model.CustomModel.IntroductionCreateViewModel
<script src="~/AppJs/introduction.js"></script>
@using (Ajax.BeginForm("Edit", "Introduction", null,
                new AjaxOptions
                {
                    HttpMethod = "POST",
                    OnSuccess = "Introduction.onEditSuccess"
                },
                new { @id = "frmData", @class = "form-horizontal" }))
{
    @Html.HiddenFor(x => x.ID)
    @Html.HiddenFor(x => x.CreatedDate)
    <div class="article-create">
        <div class="form-group">
            <div class="col-md-2 text-left">
                <a href="/admin/introduction" class=""><i class="fa fa-arrow-left" aria-hidden="true"></i> Quay trở lại</a>
            </div>
            <div class="col-md-6">
                <h4>Cập nhật sản phẩm</h4>
            </div>
        </div>
        <div class="form-group">
            <label class="col-md-1 control-label">Ảnh <span class="asterisk"> (*)</span></label>
            <div class="col-md-10">
                <div class="col-md-2">
                    @{ Html.RenderAction("UploadImage", "UploadFile", new { controlName = "Image" });}
                </div>
                <img style="width:150px" src="@Model.Image" id="prevImages">
                <span class="error" id="spImg"></span>
            </div>
        </div>
        @*<div class="form-group">
                <label class="col-md-1 control-label">Video <span class="asterisk"> (*)</span></label>
                <div class="col-md-10 pull-right">
                    <div class="radio radio-info radio-inline" onclick="$('.indirect').hide(); $('.direct').show();">
                            <input type="radio" id="direct" value="1" name="Type">
                            <label for="direct"> Trực tiếp </label>
                        </div>
                    <div class="radio radio-info radio-inline" onclick="$('.indirect').show(); $('.direct').hide();">
                        <input type="radio" id="indirect" value="2" name="Type" checked="">
                        <label for="indirect"> Youtube </label>
                    </div>
                </div>
            </div>*@
        <div class="form-group direct">
            <label class="col-md-1 control-label">Video <span class="asterisk"> (*)</span></label>
            <div class="col-md-10 pull-right">
                <input type="file" id="btn-upload-video" class="btn btn-success btn-flat browser-image hidden" value="Chọn file văn bản">
                @if (Model.UrlVideo == null)
                {
                    <div class="upload-ajax">
                        <a href="javascript:void(0)" type="button" id="Upload" class="btn btn-info" onclick="$('#btn-upload-video').click()"><i class="md-file-upload"></i> Upload video </a>
                        <i class="ion-loading-a loading-ajax" style="display: none;"></i>
                    </div>
                }
                <div id="fileupload" class="fileupload">
                    <video width="320" height="240" controls>
                        <source id="s-video" src="@Model.UrlVideo" type="video/mp4">
                    </video>
                    @if (Model.UrlVideo != null)
                    {
                        <div style="display: inline-block; position: absolute;">
                            <a href="#" class="del-video" data-path="@Model.UrlVideo" title="Xóa" onclick="deleteVideo(this)"><i class="fa fa-times"></i></a>
                        </div>
                    }
                </div>
            </div>
        </div>
        @*<div class="form-group indirect">
                <label class="col-md-2 control-label">Url</label>
                <div class="col-md-10">
                    <input type="text" id="urlyoutube" name="Url" class="form-control" placeholder="https://www.youtube.com/watch?v=id" />
                    <div class="wrap-thumb-video" id="iframeyoutube">
                        @Html.HiddenFor(g => g.Images)
                        <img id="imgyoutube" src="/Content/Admin/assets/ckeditor/plugins/image/images/noimage.png" width="320" height="240" />
                    </div>
                </div>
            </div>*@
        <ul class="nav nav-tabs lang-tabs">
            @for (int i = 0; i < Model.Languages.Count; i++)
            {
                <li class="@(i == 0 ? "active" : "")">
                    <a href="#lang-@Model.Languages[i].LangCode"
                       data-toggle="tab">
                        @Model.Languages[i].LangName
                    </a>
                </li>
            }
        </ul>
        <div class="tab-content">
            @for (int i = 0; i < Model.Languages.Count; i++)
            {
                var lang = Model.Languages[i];
                <div id="lang-@lang.LangCode"
                     class="tab-pane @(i == 0 ? "active" : "")">
                    <div class="form-group">
                        <label>Tiêu đề</label>
                        @Html.TextBoxFor(m => m.Languages[i].Title, new { @class = "form-control" })
                    </div>
                    <div class="form-group">
                        <label>Mô tả</label>
                        @Html.TextAreaFor(m => m.Languages[i].Description, new { @class = "form-control article-description" })
                    </div>
                    <div class="form-group">
                        <label>Nội dung <span class="asterisk"> (*)</span></label>
                        @Html.TextAreaFor(m => m.Languages[i].Contents, new { @class = "form-control article-content" })
                    </div>
                    @Html.HiddenFor(m => m.Languages[i].ID)
                    @Html.HiddenFor(m => m.Languages[i].LangCode)
                    @Html.HiddenFor(m => m.Languages[i].LangName)
                </div>
            }
        </div>
        <div class="form-group">
            <div class="col-md-2 text-left"><a href="/admin/introduction" class=""><i class="fa fa-arrow-left" aria-hidden="true"></i> Quay trở lại</a></div>
            <div class="col-md-7 text-center">
                <button type="submit" class="btn btn-primary waves-effect waves-light">Cập nhật</button>
            </div>
        </div>
    </div>
    <input type="hidden" id="indirect" value="2" name="Type">
    <input type="hidden" id="indirect" value="1" name="PageElementId">
    @Html.HiddenFor(g => g.UrlVideo)
}
<script src="~/Content/plugins/ckeditor/ckeditor.js"></script>
<script src="~/Content/plugins/ckfinder/ckfinder.js"></script>
<script>
    function deleteVideo(vdeo)
    {
        let id = $('#ID').val();
        let fullPath = $(vdeo).data('path');
        let fName = fullPath.split('/')[4];
        AjaxService.POST("/Admin/Video/Delete", { id: id, fPath: fName }, function (res) {
            if (res.status)
            {
               /* document.querySelector('#s-video').setAttribute('src','')*/
                location.reload();
            }
            alert(res.msg);
        });
    }

    $(document).ready(function () {
        $('#Title').on('blur', function () {
            let link = $('#Title').val();
            let linkSeo = RemoveMarkStr(link);
            $('#LinkSeo').val(linkSeo);
        })
        $("#frmData #urlyoutube").change(function () {
            var img = jYoutube($(this).val(), 320);
            $("#frmData #imgyoutube").attr('src', img);
            $("#frmData #Images").val(img);
            $("#frmData #Url").val($("#urlyoutube").val());
        });
        $("#btn-upload-video").uploadvideo(".loading-ajax", function (res) {
            var htmlvideo = '<video width="320" height="240" controls>\
        <source src="' + res.file.FileName + '" type="video/mp4">\
    </video>';
            $("#fileupload").html(htmlvideo);
            $("#UrlVideo").val(res.file.FileName);
            $(".loading-ajax").hide();
        });
    });
    $('.article-description').each(function () {
        var textareaId = $(this).attr('id');
        var editor = CKEDITOR.replace(textareaId, {
            height: '200px',
            startupFocus: true,
            language: 'vi',
            filebrowserBrowseUrl: "/Content/plugins/ckfinder/ckfinder.html",
            filebrowserImageBrowseUrl: '/Content/plugins/ckfinder/ckfinder.html?Type=Images',
            filebrowserFlashBrowseUrl: '/Content/plugins/ckfinder/ckfinder.html?Type=Flash',
            filebrowserUploadUrl: '/Scripts/ckfinder/core/connector/aspx/connector.aspx?command=QuickUpload&type=Files',
            filebrowserImageUploadUrl: '/Scripts/ckfinder/core/connector/aspx/connector.aspx?command=QuickUpload&type=Images',
            filebrowserFlashUploadUrl: '/Scripts/ckfinder/core/connector/aspx/connector.aspx?command=QuickUpload&type=Flash'
        });
    })
    $('.article-content').each(function () {
        var textareaId = $(this).attr('id');
        var editor = CKEDITOR.replace(textareaId, {
            height: '500px',
            startupFocus: true,
            language: 'vi',
            filebrowserBrowseUrl: "/Content/plugins/ckfinder/ckfinder.html",
            filebrowserImageBrowseUrl: '/Content/plugins/ckfinder/ckfinder.html?Type=Images',
            filebrowserFlashBrowseUrl: '/Content/plugins/ckfinder/ckfinder.html?Type=Flash',
            filebrowserUploadUrl: '/Scripts/ckfinder/core/connector/aspx/connector.aspx?command=QuickUpload&type=Files',
            filebrowserImageUploadUrl: '/Scripts/ckfinder/core/connector/aspx/connector.aspx?command=QuickUpload&type=Images',
            filebrowserFlashUploadUrl: '/Scripts/ckfinder/core/connector/aspx/connector.aspx?command=QuickUpload&type=Flash'
        });
    })
    function jYoutube(url, size) {
        if (url === null) { return ""; }

        size = (size === null) ? "big" : size;
        var vid;
        var results;

        results = url.match("[\?&]v=([^&#]*)");

        vid = (results === null) ? url : results[1];

        if (size == "small") {
            return "http://img.youtube.com/vi/" + vid + "/2.jpg";
        } else {
            return "http://img.youtube.com/vi/" + vid + "/0.jpg";
        }
    }
</script>