<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>
<script src="~/Content/plugins/ckeditor5/ckeditor.js"></script>
<script>
    function getValueTopic(ckb) {
        $('#MenuID').val(ckb);
    }
    $(document).ready(function () {
        $('.package-price').on("keypress", function (event) {
            return event.charCode >= 48 && event.charCode <= 57
        });
        $('html, body').animate({ scrollTop: 0 }, 500);
        $('.lockchar').on("keypress", function (e) {
            return e.charCode >= 48 && e.charCode <= 57
        });
        $("#frmData").validate({
            rules:
            {
                ProductCode:
                {
                    required: true,
                    maxlength: 10
                },
                Price: {
                    required: true
                }
            },
            messages:
            {
                ProductCode:
                {
                    required: "Vui lòng nhập mã sản phẩm"
                },
                Price: {
                    required: "Vui lòng nhập giá"
                }
            },
            highlight: function (element) {
                jQuery(element).closest('.form-group').removeClass('has-success').addClass('has-error');
            },
            success: function (element) {
                jQuery(element).closest('.form-group').removeClass('has-error');
            }
        });
    });

</script>
<script>
    let days = [];
    let dayIndex = 0;
    const languages = [
        {
            code: 'en',
            name: 'English'
        },
        {
            code: 'es',
            name: 'Spain'
        }
    ];
    function addDay() {
        dayIndex++;
        const dayId = dayIndex;
        const day = document.createElement('div');
        day.className = 'day-item';
        day.dataset.day = dayId;
        day.innerHTML =
            `<div class="day-header">
                <label>Ngày ${dayId}</label>
            </div>
            <div class="language-tabs">
            ${languages.map(lang => `
                <button type="button" class="btn lang-tab ${lang.code === 'en' ? 'active' : ''}" data-lang="${lang.code}">${lang.name}</button>`).join('')}
        </div>
        <input type="text" id="day-${dayId}" class="form-control destination" placeholder = "Ngày ${dayId}:..."/>
        <textarea id="editor-${dayId}" spellcheck = "false"></textarea>`;

        document.getElementById('days').appendChild(day);

        // Data của ngày
        const dayData = {
            day: dayId,
            currentLanguage: 'en',
            title: {
                en: '',
                es: ''
            },
            contents: {
                en: '',
                es: ''
            },
            editor: null
        };

        days.push(dayData);

        // Tạo CKEditor
        ClassicEditor.create(document.getElementById(`editor-${dayId}`), {
            toolbar: [
                'heading',
                '|',
                'bold',
                'italic',
                'underline',
                'link',
                'bulletedList',
                'numberedList',
                '|',
                'blockQuote',
                'insertTable',
                'undo',
                'redo'
            ]
        }).then(function (editor) {
            dayData.editor = editor;
            setupLanguageTabs(day, dayData);
        }).catch(function (error) {
            console.error(error);
        });
    }

    function setupLanguageTabs(dayElement, dayData) {
        const tabs = dayElement.querySelectorAll('.lang-tab');
        const input = dayElement.querySelector('.destination');
        tabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
                // Lưu input của language hiện tại
                dayData.title[dayData.currentLanguage] = input.value;
                // Lưu CKEditor hiện tại
                dayData.contents[dayData.currentLanguage] = dayData.editor.getData();
                // Language mới
                const newLanguage = this.dataset.lang;
                dayData.currentLanguage = newLanguage;
                // Load input của language mới
                input.value = dayData.title[newLanguage] || '';
                // Load CKEditor của language mới
                dayData.editor.setData(
                    dayData.contents[newLanguage] || ''
                );
                tabs.forEach(function (item) {
                    item.classList.remove('active');
                });
                this.classList.add('active');
            });
        });
    }

    const editors = {};
    document.querySelectorAll('.content-note').forEach(function (textarea) {
        const type = textarea.dataset.type;
        const lang = textarea.dataset.lang;
        ClassicEditor.create(textarea, {
            toolbar: [
                'heading',
                '|',
                'bold',
                'italic',
                'underline',
                'link',
                'bulletedList',
                'numberedList',
                '|',
                'blockQuote',
                'insertTable',
                'undo',
                'redo'
            ]
        }).then(function (editor) {
            if (!editors[type]) {
                editors[type] = {};
            }
            editors[type][lang] = editor;
        }).catch(function (error) {
            console.error(error);
        });
    });

    function getData() {
        days.forEach(function (day) {
            const input = document.querySelector(`[data-day="${day.day}"] .destination`);
            if (input.value !== '') {
                day.title[day.currentLanguage] = input.value;
                day.contents[day.currentLanguage] = day.editor.getData();
            }
        });

        const result = days.map(function (day, index) {
            return {
                day: index + 1,
                title: {
                    en: day.title.en,
                    es: day.title.es
                },
                content: {
                    en: day.contents.en,
                    es: day.contents.es
                }
            };
        });
        let Itineraries = [];
        const languages = ['en', 'es'];

        for (var i = 0; i < languages.length; i++) { 
            result.map(item => ( 
                Itineraries.push(
                    {
                        Day: item.day,
                        Title: item.title[languages[i]],
                        Contents: item.content[languages[i]],
                        LangCode: languages[i],
                        ProductID: $('#ID').val()
                    }
                )
            )
            );
        }
        $('#ItineraryData').val(JSON.stringify(Itineraries));
        $('#Itineraries').val(JSON.stringify(result));

        const notes = {};
        Object.keys(editors).forEach(function (type) {
            notes[type] = {};
            Object.keys(editors[type]).forEach(function (lang) {
                notes[type][lang] =
                    editors[type][lang].getData();
            });
        });
        let importantNotes = [];

        if (notes.included.en != '') {
            importantNotes.push({
                KeyNote: 'included',
                Contents: notes.included.en,
                LangCode: 'EN'
            })
        }
        if (notes.included.es != '') {
            importantNotes.push({
                KeyNote: 'included',
                Contents: notes.included.es,
                LangCode: 'ES'
            })
        }
        if (notes.excluded.en != '') {
            importantNotes.push({
                KeyNote: 'excluded',
                Contents: notes.excluded.en,
                LangCode: 'EN'
            })
        }
        if (notes.excluded.es != '') {
            importantNotes.push({
                KeyNote: 'excluded',
                Contents: notes.excluded.es,
                LangCode: 'ES'
            })
        }
        if (notes.important.en != '') {
            importantNotes.push({
                KeyNote: 'important',
                Contents: notes.important.en,
                LangCode: 'EN'
            })
        }
        if (notes.important.es != '') {
            importantNotes.push({
                KeyNote: 'important',
                Contents: notes.important.es,
                LangCode: 'ES'
            })
        }
        if (notes.highlights.en != '') {
            importantNotes.push({
                KeyNote: 'highlights',
                Contents: notes.highlights.en,
                LangCode: 'EN'
            })
        }
        if (notes.highlights.es != '') {
            importantNotes.push({
                KeyNote: 'highlights',
                Contents: notes.highlights.es,
                LangCode: 'ES'
            })
        }

        $('#ImportantNotes').val(JSON.stringify(importantNotes));

        var locations = [];
        $('#locationList .location-item').each(function (index) {

            locations.push({
                LocationId: $(this).data('location-id'),
                SortOrder: index + 1
            });
        });
        $('#LocationID').val(JSON.stringify(locations));

        $('#frmData').submit();
    }

    function saveSuccess(res) {
        if (res.IsSuccess == true) {
            alertmsg.success(res.Messenger);
            modal.hide();
        } else {
            alertmsg.error(res.Messenger);
        }
    }
</script>
<script>
    new Sortable(document.getElementById('locationList'), {
        animation: 200,
        handle: '.drag',
        onEnd: function () {
            updateSortOrder();
        }
    });
    function updateSortOrder() {
        $('#locationList .location-item').each(function (index) {
            $(this).find('.order').text(index + 1);
        });
    }
    $(document).on('click', '.remove', function () {
        $(this).closest('.location-item').remove();
        updateSortOrder();
    });
</script>