<script>
    let days = [];
    let dayIndex = 0;
    const languages = [
        {
            code: 'en',
            name: 'English'
        },
        {
            code: 'es',
            name: 'Spain'
        }
    ];
    function addDay() {
        /*<button type="button" class="btn btn-delete-day" onclick="removeDay(${dayId})">Xóa ngày</button>*/
        dayIndex++;
        const dayId = dayIndex;
        const day = document.createElement('div');
        day.className = 'day-item';
        day.dataset.day = dayId;
        day.innerHTML =
            `<div class="day-header">
                <label>Ngày ${dayId}</label>
            </div>
            <div class="language-tabs">
            ${languages.map(lang => `
                <button type="button" class="btn lang-tab ${lang.code === 'en' ? 'active' : ''}" data-lang="${lang.code}">${lang.name}</button>`).join('')}
        </div>
        <input type="text" id="day-${dayId}" class="form-control destination" placeholder = "Ngày ${dayId}:..."/>
        <textarea id="editor-${dayId}"></textarea>`;

        document.getElementById('days').appendChild(day);

        // Data của ngày
        const dayData = {
            day: dayId,
            currentLanguage: 'en',
            title: {
                en: '',
                es: ''
            },
            contents: {
                en: '',
                es: ''
            },
            editor: null
        };

        days.push(dayData);

        // Tạo CKEditor
        ClassicEditor.create(document.getElementById(`editor-${dayId}`), {
            toolbar: [
                'heading',
                '|',
                'bold',
                'italic',
                'underline',
                'link',
                'bulletedList',
                'numberedList',
                '|',
                'blockQuote',
                'insertTable',
                'undo',
                'redo'
            ]
        }).then(function (editor) {
            dayData.editor = editor;
            setupLanguageTabs(day, dayData);
        }).catch(function (error) {
            console.error(error);
        });
    }

    function setupLanguageTabs(dayElement, dayData) {
        const tabs = dayElement.querySelectorAll('.lang-tab');
        const input = dayElement.querySelector('.destination');
        tabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
                // Lưu input của language hiện tại
                dayData.title[dayData.currentLanguage] = input.value;
                // Lưu CKEditor hiện tại
                dayData.contents[dayData.currentLanguage] = dayData.editor.getData();
                // Language mới
                const newLanguage = this.dataset.lang;
                dayData.currentLanguage = newLanguage;
                // Load input của language mới
                input.value = dayData.title[newLanguage] || '';
                // Load CKEditor của language mới
                dayData.editor.setData(
                    dayData.contents[newLanguage] || ''
                );
                tabs.forEach(function (item) {
                    item.classList.remove('active');
                });
                this.classList.add('active');
            });
        });
    }

    function removeDay(dayId) {
        if (!confirm('Bạn có chắc muốn xóa ngày này?')) {
            return;
        }
        const index = days.findIndex(x => x.day === dayId);
        if (index === -1) {
            return;
        }
        const dayData = days[index];
        if (dayData.editor) {
            dayData.editor.destroy()
                .then(function () {
                    console.log('Editor destroyed:', dayId);
                })
                .catch(function (error) {
                    console.error(error);
                });
        }
        const dayElement = document.querySelector(`[data-day="${dayId}"]`);

        if (dayElement) {
            dayIndex = dayIndex - 1;
            dayElement.remove();
        }

        days.splice(index, 1);
    }

    function getData() {
        days.forEach(function (day) {
            const input = document.querySelector(`[data-day="${day.day}"] .destination`);
            // Lưu language hiện tại
            if (input.value !== '') {
                day.title[day.currentLanguage] = input.value;
                day.contents[day.currentLanguage] = day.editor.getData();
            }
        });

        const result = days.map(function (day, index) {
            return {
                day: index + 1,
                title: {
                    en: day.title.en,
                    es: day.title.es
                },
                content: {
                    en: day.contents.en,
                    es: day.contents.es
                }
            };
        });
        let Itineraries = [];
        const languages = ['en', 'es'];

        for (var i = 0; i < languages.length; i++) {
            result.map(item => (
                Itineraries.push(
                    {
                        Title: item.title[languages[i]],
                        Contents: item.content[languages[i]],
                        LangCode: languages[i],
                        ProductID: $('#ID').val()
                    }
                )
            )
            );
        }
        $('#ItineraryData').val(JSON.stringify(Itineraries));
        $('#Itineraries').val(JSON.stringify(result));
        $('#frmData').submit();
    }

    function saveSuccess(res) {
        if (res.IsSuccess == true) {
            alertmsg.success(res.Messenger);
            modal.hide();
        } else {
            alertmsg.error(res.Messenger);
        }
    }
    function toggleBlock(header) {
        const block = header.closest('.info-block');
        block.classList.toggle('collapsed');
    }
</script>