                                <td><input data-id="0" data-pax="1-2" class="package-price form-control" value="" />&nbsp;<span class="unit">$</span></td>
                                <td><input data-id="0" data-pax="3-4" class="package-price form-control" value="" />&nbsp;<span class="unit">$</span></td>
                                <td><input data-id="0" data-pax="5-6" class="package-price form-control" value="" />&nbsp;<span class="unit">$</span></td>
                                <td><input data-id="0" data-pax="7-8" class="package-price form-control" value="" />&nbsp;<span class="unit">$</span></td>
                                <td><input data-id="0" data-pax="9-10" class="package-price form-control" value="" />&nbsp;<span class="unit">$</span></td>
                                <td><input data-id="0" data-pax="11-20" class="package-price form-control" value="" />&nbsp;<span class="unit">$</span></td>
                            </tr>
                            <tr id="package-5">
