@using Web.Model
@{
    ViewBag.Title = "Thêm mới sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var menus = (List<MenuTran>)TempData["Menus"];
    var countries = (List<Web.Model.CountryTran>)TempData["CountryTrans"];
} 
<style>
    .text-bold {
        font-weight: bold;
        width: 130px;
        vertical-align: middle !important;
    }

    table, th, td {
        border: 1px solid #ddd;
        border-collapse: collapse;
    }

    .package-price {
        width: 80%;
        display: inline-block
    } 
</style>
<link href="~/Content/Admin/css/product.css" rel="stylesheet" />
<script src="~/AppJs/product.js"></script>
@model Web.Model.CustomModel.ProductCreateViewModel
@using (Ajax.BeginForm("Add", "Product", null,
    new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Product.onAddSuccess"
    },
    new { @id = "frmData", @class = "form-horizontal" }))
{
    @Html.HiddenFor(x => x.MenuID)
    @Html.HiddenFor(x => x.Itineraries)
    <div id="countryIds"></div>
    <div id="hotelIds"></div>
    <input type="hidden" name="Package_Price" id="Package_Price" value="" />
    <div class="article-create">
        <div class="form-group">
            <div class="col-md-2 text-left">
                <a href="/admin/product" class=""><i class="fa fa-arrow-left" aria-hidden="true"></i> Quay trở lại</a>
            </div>
            <div class="col-md-6">
                <span style="font-size:18px">Thêm mới sản phẩm</span>
