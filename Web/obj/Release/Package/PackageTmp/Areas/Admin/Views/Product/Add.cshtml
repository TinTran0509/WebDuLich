@using Web.Model
@{
    ViewBag.Title = "Thêm mới sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var menus = (List<MenuTran>)TempData["Menus"];
    var countries = (List<Web.Model.CountryTran>)TempData["CountryTrans"];
}
<style>
    #ProductCode{
        width:230px !important
    }
    .text-bold {
        font-weight: bold;
        width: 130px;
        vertical-align: middle !important;
    }

    table, th, td {
        border: 1px solid #ddd;
        border-collapse: collapse;
    }

    .package-price {
        width: 80%;
        display: inline-block
    }

    .language-panel {
        width: 100%;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
    }
    /* Tabs */

    .language-tabs-note {
        display: flex;
        gap: 5px;
        padding: 10px 10px 0;
        background: #f5f6f8;
        border-bottom: 1px solid #ddd;
    }

    .language-tab {
        padding: 9px 18px;
        border: 1px solid #ddd;
        border-bottom: none;
        border-radius: 6px 6px 0 0;
        background: #e9ecef;
        color: #555;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
    }

        .language-tab:hover {
            background: #ddd;
        }

        .language-tab.active {
            background: #fff;
            color: #007bff;
            border-color: #ddd;
            font-weight: 600;
        }
    /* Content */

    .language-content {
        padding: 20px;
    }

    .language-pane {
        display: none;
    }

        .language-pane.active {
            display: block;
        }

    .form-group {
        margin-bottom: 15px;
    }  
    .form-control:focus {
        border-color: #007bff;
        box-shadow: 0 0 0 2px rgba(0, 123, 255, .1);
    }
</style>
<style>
    .tour-location {
        width: 100%;
        max-width: 650px;
        background: #fff;
        padding: 20px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
    }

    .location-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 15px;
    }

        .location-header h3 {
            margin: 0;
            font-size: 18px;
        }

    #btnAddLocation {
        border: 0;
        background: #2563eb;
        color: #fff;
        padding: 8px 14px;
        border-radius: 6px;
        cursor: pointer;
    }

    .location-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        margin-bottom: 8px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #f9fafb;
    }

    .drag {
        cursor: grab;
        color: #9ca3af;
        font-size: 18px;
    }

    .order {
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #2563eb;
        color: #fff;
        border-radius: 50%;
        font-weight: bold;
    }

    .location-name {
        flex: 1;
    }

    .remove {
        border: 0;
        background: transparent;
        color: #ef4444;
        font-size: 22px;
        cursor: pointer;
    }
</style>
<link href="~/Content/Admin/css/product.css" rel="stylesheet" />
