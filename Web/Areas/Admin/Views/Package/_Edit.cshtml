@using Web
@using Web.Model
@model Package
@using (Ajax.BeginForm("Edit", "Package", null,
                new AjaxOptions
                {
                    HttpMethod = "POST",
                    OnSuccess = "Package.onAddSuccess"
                },
                new { @id = "basicForm", @class = "form-horizontal" }))
{
    <div class="form-group">
        <label class="col-md-2 control-label">Tên gói <span class="asterisk">(*)</span></label>
        <div class="col-md-10">
            @Html.TextBoxFor(g => g.Title, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <label class="col-md-2 control-label">Thứ tự <span class="asterisk">(*)</span></label>
        <div class="col-md-2 lockChar">
            @Html.TextBoxFor(g => g.Ordering, new { @class = "form-control", @type = "number" })
        </div>
    </div>
    <div class="text-center">
        <button type="submit" class="btn btn-primary waves-effect waves-light">Cập nhật</button>
    </div>
}
<script>
    // Basic Form
    $(document).ready(function () {
        $('.lockChar').on("keypress", function (event) {
            return event.charCode >= 48 && event.charCode <= 57
        })
        $("#basicForm").validate({
            rules:
            {
                Name:
                {
                    required: true
                },
                Ordering:
                {
                    required: true
                }
            },
            messages:
            {
                Name:
                {
                    required: "Chưa nhập tên gói"
                },
                Ordering:
                {
                    required: "Thứ tự không để trống"
                }
            }
        });
    });
    var validate = function () {
        if ($("#Images").val() == "") {
            alertmsg.error("Bạn chưa chọn ảnh");
            return false;
        }
        if ($("#typeslide").val() == "") {
            alertmsg.error("Bạn chưa chọn loại slider");
            return false;
        }
        return true;
    }
</script>