@using Web.Model
@model tbl_User
@{
    //var countries = (List<Country>)TempData["Countries"];
    var languages = (List<tbl_Languages>)TempData["Languages"];
}
@using (Ajax.BeginForm("Add", "User", null,
    new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "User.onAddSuccess"
    },
    new { @id = "basicForm", @class = "form-horizontal" }))
{
    @*<div class="form-group">
            <label class="col-md-2 control-label">Quốc gia<span class="asterisk"> (*)</span></label>
            <div class="col-md-6">
                <select class="form-control select2" id="CountryID" name="CountryID">
                    <option value="0">--- Chọn ---</option>
                    @foreach (var item in countries)
                    {
                        <option value="@item.ID">@item.Name</option>
                    }
                </select>
            </div>
        </div>*@
    <div class="form-group">
        <label class="col-md-2 control-label">Ngôn ngữ hỗ trợ<span class="asterisk"> (*)</span></label>
        <div class="col-md-6">
            <select class="form-control select2" id="LangID" name="LangID">
                <option value="0">--- Chọn ---</option>
                @foreach (var item in languages)
                {
                    <option value="@item.ID">@item.LangName</option>
                }
            </select>
        </div>
    </div>
    <div class="form-group">
        <label class="control-label col-md-2">Avatar</label>
        <div class="col-md-10">
            <div class="col-md-2">
                @{ Html.RenderAction("UploadImage", "UploadFile", new { controlName = "Photo" });}
            </div>
            <img src="" style="width:150px" id="prevImages">
            <span class="error" id="spImg"></span>
        </div>
    </div>
    <div class="form-group">
        <label class="col-md-2 control-label">Full Name<span class="asterisk"> (*)</span></label>
        <div class="col-md-6">
            @Html.TextBoxFor(g => g.FullName, new { @class = "form-control", placeholder = "Full Name" })
        </div>
    </div>
    <div class="form-group">
        <label class="col-md-2 control-label">Email<span class="asterisk"> (*)</span></label>
        <div class="col-md-6">
            @Html.TextBoxFor(g => g.Email, new { @class = "form-control", placeholder = "Email" })
        </div>
    </div>
    <div class="form-group">
        <label class="col-md-2 control-label">Tel<span class="asterisk"> (*)</span></label>
        <div class="col-md-6">
            @Html.TextBoxFor(g => g.Phone, new { @class = "form-control", placeholder = "Tel" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-sm-10 pull-right">
            <div class="checkbox checkbox-primary">
                <input id="Active" name="Active" type="checkbox" checked="" value="true">
                <label for="Active">
                    Active
                </label>
            </div>
        </div>
    </div>
    <div class="text-center">
        <button type="submit" class="btn btn-primary waves-effect waves-light">Thêm mới</button>
    </div>
}
<script>
    // Basic Form
    $(document).ready(function () {
        $("#basicForm").validate({
            rules:
            {
                FullName:
                {
                    required: true,
                    maxlength: 150
                },
                Email:
                {
                    required: true,
                    maxlength: 250
                },
                Phone:
                {
                    required: true,
                    maxlength: 20
                }
            },
            messages:
            {
                FullName:
                {
                    required: "Vui lòng nhập full name"
                },
                Email:
                {
                    required: "Vui lòng nhập email"
                },
                Phone:
                {
                    required: "Vui lòng nhập tel"
                }
            },
            highlight: function (element) {
                jQuery(element).closest('.form-group').removeClass('has-success').addClass('has-error');
            },
            success: function (element) {
                jQuery(element).closest('.form-group').removeClass('has-error');
            }
        });
    });
</script>