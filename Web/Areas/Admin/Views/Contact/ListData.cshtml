@using Web.Core
@using Web.Model.CustomModel

@model List<Web.Model.News>
   
@{
    var lstAction = (List<int>)HttpContext.Current.Session["Action"];
}
<div class="col-xs-12">
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Tiêu đề</th>  
                <th>Nội dung</th> 
                <th>Ngày tạo</th> 
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MetaTitle</td> 
                    <td>@HelperString.TruncateByWord(HelperString.StripHTML(HttpUtility.HtmlDecode(item.Contents)), 120)</td> 
                    <td>@string.Format("{0:dd/MM/yyyy HH:mm}",item.CreatedDate)</td>
                    <td style="width:100px"> 
                        @if (lstAction != null && lstAction.Contains((int)EnumHelper.Action.Edit))
                        {
                            <a href="/Admin/contact/Edit/@item.ID" class="btn btn-success btn-bordered" title="Sửa">
                                <i class="glyphicon glyphicon-pencil"></i>
                            </a>
                        }
                        @if (lstAction != null && lstAction.Contains((int)EnumHelper.Action.Delete))
                        {
                            <a href="javascript:void(0)" class="btn btn-danger btn-bordered" onclick="contact.ondelete(@item.ID) " title="Xóa">
                                <i class="glyphicon glyphicon-trash"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>