    const editors = {}; document.querySelectorAll('.content-note').forEach(function(textarea) {
        const type = textarea.dataset.type;
        const lang = textarea.dataset.lang;
        ClassicEditor.create(textarea, {
            toolbar: [
                'heading',
                '|',
                'bold',
                'italic',
                'underline',
                'link',
                'bulletedList',
                'numberedList',
                '|',
                'blockQuote',
                'insertTable',
                'undo',
                'redo'
            ]
        }).then(function (editor) {
            if (!editors[type]) {
                editors[type] = {};
            }
            editors[type][lang] = editor;
        }).catch(function (error)
        {
            console.error(error);
        });
    });

    // lấy dữ liệu editors.important.en.getData();
    // đổ dữ liệu editors.included.en.setData('<p>Breakfast included.</p>');

    function getDataNote() {
        const result = {};
        Object.keys(editors).forEach(function (type) {
            result[type] = {};
            Object.keys(editors[type]).forEach(function (lang) {
                result[type][lang] =
                editors[type][lang].getData();
            });
        });
        return result;
    }
