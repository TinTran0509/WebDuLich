@using Web.Model
@{
    ViewBag.Title = "Thêm mới sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var menus = (List<MenuTran>)TempData["Menus"];
    var countries = (List<Web.Model.CountryTran>)TempData["CountryTrans"];
} 
<style>
    .text-bold {
        font-weight: bold;
        width: 130px;
        vertical-align: middle !important;
    }

    table, th, td {
        border: 1px solid #ddd;
        border-collapse: collapse;
    }

    .package-price {
        width: 80%;
        display: inline-block
    }

    .language-panel {
        width: 100%;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
    }
    /* Tabs */

    .language-tabs-note {
        display: flex;
        gap: 5px;
        padding: 10px 10px 0;
        background: #f5f6f8;
        border-bottom: 1px solid #ddd;
    }

    .language-tab {
        padding: 9px 18px;
        border: 1px solid #ddd;
        border-bottom: none;
        border-radius: 6px 6px 0 0;
        background: #e9ecef;
        color: #555;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
    }

        .language-tab:hover {
            background: #ddd;
        }

        .language-tab.active {
            background: #fff;
            color: #007bff;
            border-color: #ddd;
            font-weight: 600;
        }
    /* Content */

    .language-content {
        padding: 20px;
    }

    .language-pane {
        display: none;
    }

    .language-pane.active {
        display: block;
    }
   
    .form-group {
        margin-bottom: 15px;
    }

    .form-group label {
        /* display: block;*/
        margin-bottom: 6px;
        font-size: 14px;
        font-weight: 600;
        color: #333;
    }

    .form-control {
        width: 100%;
        box-sizing: border-box;
        padding: 9px 12px;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 14px;
        outline: none;
    }

    .form-control:focus {
        border-color: #007bff;
        box-shadow: 0 0 0 2px rgba(0, 123, 255, .1);
    }

</style>
<link href="~/Content/Admin/css/product.css" rel="stylesheet" />
