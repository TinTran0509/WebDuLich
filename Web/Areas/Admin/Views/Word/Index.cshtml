@{
    ViewBag.Title = "Quản lý từ dịch";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml"; 
} 
 <style>
     .group-banner td {
         border: none !important;
     }
     .contry-name {
         width: 60px;
     }
 </style>
<script src="~/AppJs/word.js"></script>
<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Từ ngữ dịch</h3> 
                <div class="row" style="margin-bottom:10px">
                    <div class="col-md-4">
                        <input type="text" id="txtSearch" class="form-control" placeholder="Nhập từ khóa" /> 
                    </div>
                    <div class="col-md-4">
                        <button id="btnSearch" onclick="Word.loadData()" class="btn btn-primary">Tìm kiếm</button>
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-primary waves-effect waves-light" onclick="Word.loadfrmAdd() "><i class="fa fa-plus"></i> Thêm mới</button>
                    </div> 
                </div>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <div class="table-responsive" id="gridData">

                        </div>
                        <div class="col-md-12" id="paginationholder">
                            <ul id="pagination" class="pagination"></ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        Word.loadData();
    });
</script>