@{
    var lstAction = (List<int>)HttpContext.Current.Session["Action"];
    int id = 0;
}
@using Web.Model.CustomModel
@using Web.Core
@model List<IntroductionViewModel>
<style>
    .btn {
        padding: 4px 8px !important
    }
</style>
<table class="table">
    <thead>
        <tr>
            <th>Tiêu đề</th>
            <th>Hình ảnh</th>
            <th>Mô tả</th>
            <th>Nội dung</th>
            <th>Ngôn ngữ</th>
            <th style="width:120px"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        { 
            <tr>
                <td>@item.Title</td>
                <td><img src="@item.Image" style="width: 60px;" /></td>
                <td>@item.Description</td>
                <td>@HelperString.TruncateByWord(HelperString.StripHTML(HttpUtility.HtmlDecode(item.Contents)), 100)</td>
                <td>@item.LangName</td>
                @if (id != item.IntroductionID)
                {
                    <td rowspan="2">
                        <div class="btn-list pull-right mr5">
                            @if (lstAction != null && lstAction.Contains((int)EnumHelper.Action.Edit))
                            {
                                <a href="/Admin/Introduction/Edit/@item.ID" class="btn btn-primary btn-bordered" title="Sửa">
                                    <i class="glyphicon glyphicon-pencil"></i>
                                </a>
                            }
                            @*@if (lstAction != null && lstAction.Contains((int)EnumHelper.Action.Delete))
                            {
                                <a href="#" class="btn btn-danger btn-bordered" onclick="Introduction.ondelete(@item.ID) " title="Xóa">
                                    <i class="glyphicon glyphicon-trash"></i>
                                </a>
                            }*@
                        </div>
                    </td>
                }
            </tr>
            id = item.ID;
        }
    </tbody>
</table>
<script>
    $(document).ready(function () {
        $('.width50').on("keypress", function () {
            return event.charCode >= 48 && event.charCode <= 57
        })
        InitClickCheckAllInTable("chkall", function (res) {
            $("#hdfID").val(res);
        });
    });
</script>
