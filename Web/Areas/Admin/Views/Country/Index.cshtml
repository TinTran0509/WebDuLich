@{
    ViewBag.Title = "Quản lý quốc gia";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml"; 
}
@using Web.Model
 <style>
     .group-banner td {
         border: none !important;
     }
     .contry-name {
         width: 60px;
     }
 </style>
<script src="~/AppJs/country.js"></script>
<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Quốc gia</h3>
                <div style="top: 8px;position: absolute; right: 40px;" class="pull-right">
                    <button type="button" class="btn btn-primary waves-effect waves-light" onclick="Country.loadfrmAdd() "><i class="fa fa-plus"></i> Thêm mới</button> 
                </div>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <div class="table-responsive" id="gridData">

                        </div>
                        <div class="col-md-12" id="paginationholder">
                            <ul id="pagination" class="pagination"></ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        Country.loadData();
    });
</script>