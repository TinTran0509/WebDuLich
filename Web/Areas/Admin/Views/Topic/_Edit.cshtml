@using Web.Model
@model Topic

@using (Ajax.BeginForm("Edit", "Topic", null,
                new AjaxOptions
                {
                    HttpMethod = "POST",
                    OnSuccess = "Topic.onEditSuccess"
                },
                new { @id = "frmData", @class = "form-horizontal" }))
{
    @Html.HiddenFor(x => x.ID)
    <div class="form-group">
        <label class="col-md-2 control-label">Tên<span class="asterisk"> (*)</span></label>
        <div class="col-md-10">
            @Html.TextBoxFor(model => model.Title, new { @class = "form-control", @placeholder = "Nhập tiêu đề" })
        </div>
    </div>
    <div class="form-group">
        <label class="col-md-2 control-label">Ảnh<span class="asterisk"> (*)</span></label>
        <div class="col-md-10">
            <div class="col-md-2">
                @{ Html.RenderAction("UploadImage", "UploadFile", new { controlName = "Image" });}
            </div>
            <img src="@Model.Image" style="width:100px" id="prevImages">
            <span class="error" id="spImg"></span>
        </div>
    </div>
    <div class="form-group">
        <div class="col-sm-10 pull-right">
            <div class="checkbox checkbox-primary">
                <input id="Active" name="Active" type="checkbox" @(Model.Active ? "checked=''" : "") value="true">
                <label for="Active">
                    Active
                </label>
            </div>
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-12 text-center">
            <button type="submit" class="btn btn-primary waves-effect waves-light">Cập nhật</button>
        </div>
    </div>
}
<script>
    $(document).ready(function () {
    
    });
</script>