@{
    var lstAction = (List<int>)HttpContext.Current.Session["Action"];
    int id = 0, locationID = 0;
}
@using Web.Core
@using Web.Model.CustomModel
@model List<LocationViewModel>
    <table class="table">
        <thead>
            <tr>
                <th>Hình ảnh</th>
                <th>Tên</th>
                <th>Mô tả</th>
                <th>Ngôn ngữ</th>
                <th>Trạng thái</th>
                <th style="width:90px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                string group = "group-banner";
                if(locationID != item.LocationID)
                {
                    group = "";
                }
                <tr class="@group">
                    <td><img src="@item.Image" style="width: 50px;" /></td>
                    <td>@item.Name</td>
                    <td>@HelperString.TruncateByWord(HelperString.StripHTML(HttpUtility.HtmlDecode(item.Description)), 100)</td>
                    <td>@item.LangName</td>
                    <td style="">@Html.Raw((bool)item.Active ? "<span style='color:green'>Active</span>" : "<span style='color:red'>Inactive</span>")</td>
                    @if (id != item.LocationID)
                    {
                        <td rowspan="2">
                            <div class="btn-list pull-right mr5">
                                @if (lstAction != null && lstAction.Contains((int)EnumHelper.Action.Edit))
                                {
                                    <a href="/admin/location/edit?id=@item.ID" class="btn btn-primary btn-bordered" title="Sửa">
                                        <i class="glyphicon glyphicon-pencil"></i>
                                    </a>
                                }
                                @if (lstAction != null && lstAction.Contains((int)EnumHelper.Action.Delete))
                                {
                                    <a href="#" class="btn btn-danger btn-bordered" onclick="Location.ondelete(@item.ID) " title="Xóa">
                                        <i class="glyphicon glyphicon-trash"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    }
                </tr>
                id = item.ID;
                locationID = item.LocationID;
            }
        </tbody>
    </table>
    <script>
        $(document).ready(function () { 
            InitClickCheckAllInTable("chkall", function (res) {
                $("#hdfID").val(res);
            });
        });
    </script>
