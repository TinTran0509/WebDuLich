@{
    ViewBag.Title = "Thêm mới điểm đến";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var countries = (List<Web.Model.CountryTran>)TempData["CountryTrans"];
}
<style>
    .check-radio {
        display: inline-flex;
        align-items: center;
        cursor: pointer;
        margin-right: 20px;
        padding-top: 5px;
    }

        .check-radio input {
            display: none;
        }

        .check-radio span {
            position: relative;
            padding-left: 28px;
            font-weight: 500;
        }

            .check-radio span::before {
                content: "";
                position: absolute;
                left: 0;
                top: 50%;
                transform: translateY(-50%);
                width: 18px;
                height: 18px;
                border: 1px solid #999;
                border-radius: 3px; /* ô vuông giống checkbox */
                background: #fff;
            }

        .check-radio input:checked + span::before {
            background: #007bff;
            border-color: #007bff;
        }

        .check-radio input:checked + span::after {
            content: "✓";
            position: absolute;
            left: 4px;
            top: 50%;
            transform: translateY(-55%);
            color: white;
            font-size: 13px;
            font-weight: bold;
        }
</style>
<script src="~/AppJs/location.js"></script>
@model Web.Model.CustomModel.LocationCreateViewModel
@using (Ajax.BeginForm("Add", "Location", null,
    new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Location.onAddSuccess"
    },
    new { @id = "frmData", @class = "form-horizontal" }))
{
    <div class="article-create">
        <div class="form-group">
            <div class="col-md-2 text-left">
                <a href="/admin/location" class=""><i class="fa fa-arrow-left" aria-hidden="true"></i> Quay trở lại</a>
            </div>
            <div class="col-md-6">
            </div>
        </div>
        <div class="form-group">
            <label class="col-md-2 control-label">Quốc gia<span class="asterisk"> (*)</span></label>
            <div class="col-md-10">
                @foreach (var item in countries)
                {
                    <label class="check-radio">
                        <input type="radio" name="language" onclick="getValueTopic(this.value)" value="@item.CountryID">
                        <span>@item.Name</span>
                    </label>
                }
            </div>
        </div>
        <div class="form-group">
            <label class="col-md-2 control-label">Ảnh <span class="asterisk"> (*)</span></label>
            <div class="col-md-10">
                <div class="col-md-2">
                    @{ Html.RenderAction("UploadImage", "UploadFile", new { controlName = "Image" });}
                </div>
                <img style="width:150px" src="" id="prevImages">
                <span class="error" id="spImg"></span>
            </div>
        </div>
        <ul class="nav nav-tabs lang-tabs">
            @for (int i = 0; i < Model.Languages.Count; i++)
            {
                <li class="@(i == 0 ? "active" : "")">
                    <a href="#lang-@Model.Languages[i].LangCode"
                       data-toggle="tab">
                        @Model.Languages[i].LangName
                    </a>
                </li>
            }
        </ul>
        <div class="tab-content">
            @for (int i = 0; i < Model.Languages.Count; i++)
            {
                var lang = Model.Languages[i];
                <div id="lang-@lang.LangCode"
                     class="tab-pane @(i == 0 ? "active" : "")">
                    <div class="form-group">
                        <label>Tên<span class="asterisk"> (*)</span></label>
                        @Html.TextBoxFor(m => m.Languages[i].Name, new { @class = "form-control" })
                    </div>
                    <div class="form-group">
                        <label>Mô tả <span style="font-style:italic; font-weight:normal"> (Không quá 500 ký tự)</span></label>
                        @Html.TextAreaFor(m => m.Languages[i].Description, new { @class = "form-control", @spellcheck = "false", @rows = 10 })
                    </div>
                    @Html.HiddenFor(m => m.Languages[i].LangCode)
                    @Html.HiddenFor(m => m.Languages[i].LangName)
                </div>
            }
        </div>
        <div class="form-group">
            <div class="col-sm-11 pull-right">
                <div class="checkbox checkbox-primary">
                    <input id="Active" name="Active" type="checkbox" checked="" value="true">
                    <label for="Active">
                        Active
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-2 text-right"><a href="/admin/location" class=""><i class="fa fa-arrow-left" aria-hidden="true"></i> Quay trở lại</a></div>
            <div class="col-md-7 text-center">
                <button type="submit" class="btn btn-primary waves-effect waves-light">Thêm mới</button>
            </div>
        </div>
    </div>
    @Html.HiddenFor(x => x.CountryID)
}
<script>
    function getValueTopic(ckb) {
        $('#CountryID').val(ckb);
    }
    $(document).ready(function () {

    });

</script>