@using Web.Model
@model  News
@{
    ViewBag.Title = "Cập nhật";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var categories = (List<Category>)TempData["Categories"];
}
<script src="~/AppJs/service.js?v=1.0.1"></script>
@using (Ajax.BeginForm("Edit", "service", null,
                new AjaxOptions
                {
                    HttpMethod = "POST",
                    OnSuccess = "service.onEditSuccess"
                },
                new { @id = "frmData", @class = "form-horizontal" }))
{
    @Html.HiddenFor(x => x.ID)
    @Html.HiddenFor(x => x.LinkSeo)
    <div class="form-group">
        <label style="opacity:0" class="control-label col-md-1">abc</label>
        <div class="col-md-10">
            <span style="font-style:italic">Lưu ý: </span><span>Các trường có dấu (<span style="color:red">*</span>) là yêu cầu bắt buộc nhập thông tin</span>
        </div>
    </div>
    <div class="form-group">
        <label class="control-label col-md-1">Dịch vụ <span class="asterisk"> *</span></label>
        <div class="col-md-4">
            <select name="CategoryId" id="CategoryId" class="form-control">
                <option value="0">------- Chọn dịch vụ -------</option>
                @foreach (var item in categories)
                {
                    int level = (int)item.Level - 1;
                    <option value="@item.ID">@Html.Raw(string.Concat(Enumerable.Repeat("--", level)) + "&nbsp" + item.Name)</option>
                }
            </select>
        </div>
    </div>
    <div class="form-group">
        <label class="control-label col-md-1">Tiêu đề<span class="asterisk"> *</span></label>
        <div class="col-md-10">
            @Html.TextBoxFor(model => model.MetaTitle, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <label class="control-label col-md-1">Hình ảnh<span class="asterisk"> *</span></label>
        <div class="col-md-11">
            <div class="col-md-2">
                @{ Html.RenderAction("UploadImage", "UploadFile", new { controlName = "Image" });}
            </div>
            <img src="@Model.Image" style="width:50px" id="prevImages">
            <span class="error" id="spImg"></span>
        </div>
    </div>
    <div class="form-group">
        <label class="control-label col-md-1">Mô tả</label>
        <div class="col-md-11">
            @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @rows = "3" })
        </div>
    </div>
    <div class="form-group">
        <label class="control-label col-md-1">Nội dung<span class="asterisk"> *</span></label>
        <div class="col-md-11">
            @Html.TextAreaFor(model => model.Contents, new { @class = "form-control" })
            <span class="error" id="spcontent"></span>
        </div>
    </div>
    <div class="form-group">
        <div class="text-center">
            <a href="/admin/service" class="btn btn-primary"><i class="fa fa-arrow-left" aria-hidden="true"></i> Quay trở lại</a>
            <button type="submit" onclick="checkEdit()" class="btn btn-primary">Cập nhật</button>
        </div>
    </div>
} 
<script src="~/Content/plugins/jquery-tag-it/js/jquery-ui.min.js"></script>
    <script src="~/Content/plugins/ckeditor/ckeditor.js"></script>
    <script src="~/Content/plugins/ckfinder/ckfinder.js"></script>
<script>
    $(document).ready(function () {
        $('#fileUpload').on('change', function () {
            $('#spImg').text("");
        })
        $('#CategoryId').val('@Model.CategoryId')
        $('#MetaTitle').on('blur', function () {
            let link = $('#MetaTitle').val();
            let linkSeo = RemoveMarkStr(link);
            $('#LinkSeo').val(linkSeo);
        })
        $("#frmData").validate({
            rules:
            {
                MetaTitle:
                {
                    required: true,
                    maxlength: 250
                },
                Desciption:
                {
                    required: true,
                    maxlength: 500
                },
                Contents:
                {
                    required: true
                }
            },
            messages:
            {
                MetaTitle:
                {
                    required: "Vui lòng nhập tiêu đề"
                },
                Desciption:
                {
                    required: "Vui lòng nhập mô tả"
                },
                Contents:
                {
                    required: "Vui lòng nhập nội dung"
                }
            },
            highlight: function (element) {
                jQuery(element).closest('.form-group').removeClass('has-success').addClass('has-error');
            },
            success: function (element) {
                jQuery(element).closest('.form-group').removeClass('has-error');
            }
        });
    }) 
    var editor = CKEDITOR.replace('Contents', {
        height: '700px',
        startupFocus: true,
        language: 'vi',
        filebrowserBrowseUrl: "/Content/plugins/ckfinder/ckfinder.html",
        filebrowserImageBrowseUrl: '/Content/plugins/ckfinder/ckfinder.html?Type=Images',
        filebrowserFlashBrowseUrl: '/Content/plugins/ckfinder/ckfinder.html?Type=Flash',
        filebrowserUploadUrl: '/Scripts/ckfinder/core/connector/aspx/connector.aspx?command=QuickUpload&type=Files',
        filebrowserImageUploadUrl: '/Scripts/ckfinder/core/connector/aspx/connector.aspx?command=QuickUpload&type=Images',
        filebrowserFlashUploadUrl: '/Scripts/ckfinder/core/connector/aspx/connector.aspx?command=QuickUpload&type=Flash'
    });
    editor.on('change', function () {
        $("span[data-valmsg-for=Content]").html('');
    })
    function checkEdit() {
        var messageLength = CKEDITOR.instances['Contents'].getData().replace(/<[^>]*>/gi, '').length;
        if (!messageLength) {
            $("#spcontent").text("Vui lòng thêm nội dung bài viết");
            return false;
        }
    }

</script>
