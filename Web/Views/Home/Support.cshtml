
@using Web.Model.CustomModel
@{
    Layout = null;
}

@model List<UserModel>
<div class="contact-bar">
    <div>
        <div class="toggle-dropdown">
            <div class="icon">
                <img src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%3E%3C/svg%3E"
                     alt="WhatsApp messenger icon" width="24" height="24" data-lazy-src="/Content/wp-content/themes/ocanus/images/frontend/whatsappicon.png">
                <noscript>
                    <img src="/Content/wp-content/themes/ocanus/images/frontend/whatsappicon.png"
                         alt="WhatsApp messenger icon" width="24" height="24">
                </noscript>
            </div>
            @ViewBag.MessagerWhatsApp
        </div>
        <div class="dropdown-content fsz-12">
            <span class="btn-close">✕</span>
            <div class="mb-5 pl-15 pr-15 text-center">
            </div>
            @foreach (var item in Model)
             {
                <div class="item">
                    <a href="https://wa.me/13056159832"
                       rel="nofollow"
                       target="_blank"
                       class="d-block whatsappus"
                       title="@item.FullName">
                        <img class="avatar" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2045%2045'%3E%3C/svg%3E"
                             alt="@item.FullName" width="45" height="45" data-lazy-src="@item.Photo">
                        <noscript>
                            <img class="avatar" src="@item.Photo"
                                 alt="@item.FullName" width="45" height="45">
                        </noscript>
                        <span>
                            <b>@item.FullName</b>
                            <br>
                            @item.Description
                            <br>
                            <span class="d-inline-flex align-items-center gap-10">
                                <img src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2015%2010'%3E%3C/svg%3E"
                                     alt="EE. UU. " width="15" height="10" data-lazy-src="@item.Flag"><noscript>
                                    <img src="@item.Flag"
                                         alt="EE. UU. " width="15" height="10">
                                </noscript>
                                @item.LangName
                            </span>
                        </span>
                        <span class="whatsapp-icon">
                            <img src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2016%2016'%3E%3C/svg%3E"
                                 alt="WhatsApp messenger icon" width="16" height="16" data-lazy-src="/Content/wp-content/themes/ocanus/images/frontend/whatsapp.png"><noscript>
                                <img src="/Content/wp-content/themes/ocanus/images/frontend/whatsapp.png"
                                     alt="WhatsApp messenger icon" width="16" height="16">
                            </noscript>
                        </span>
                    </a>
                </div>
             } 
            <p class="bottom-text d-flex align-items-center pl-15 pr-15">
                <svg width="15" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M544 144C552.8 144 560 151.2 560 160L560 480C560 488.8 552.8 496 544 496L96 496C87.2 496 80 488.8 80 480L80 160C80 151.2 87.2 144 96 144L544 144zM96 96C60.7 96 32 124.7 32 160L32 480C32 515.3 60.7 544 96 544L544 544C579.3 544 608 515.3 608 480L608 160C608 124.7 579.3 96 544 96L96 96zM240 312C270.9 312 296 286.9 296 256C296 225.1 270.9 200 240 200C209.1 200 184 225.1 184 256C184 286.9 209.1 312 240 312zM208 352C163.8 352 128 387.8 128 432C128 440.8 135.2 448 144 448L336 448C344.8 448 352 440.8 352 432C352 387.8 316.2 352 272 352L208 352zM408 208C394.7 208 384 218.7 384 232C384 245.3 394.7 256 408 256L488 256C501.3 256 512 245.3 512 232C512 218.7 501.3 208 488 208L408 208zM408 304C394.7 304 384 314.7 384 328C384 341.3 394.7 352 408 352L488 352C501.3 352 512 341.3 512 328C512 314.7 501.3 304 488 304L408 304z" /></svg>
                <span>@Html.Raw(ViewBag.SupportNow)</span>
            </p>
        </div>
    </div>
</div>