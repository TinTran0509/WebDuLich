@using Web.Model.Domain;
@{
    Layout = null;
}
@model List<Web.Model.Category>

<div class="sidebar-menu no-scrollbar ">
    <ul class="nav nav-sidebar nav-vertical nav-uppercase" data-tab="1">
        <li class="header-search-form search-form html relative has-icon">
            <div class="header-search-form-wrapper">
                <div class="searchform-wrapper ux-search-box relative is-normal">
                    <form method="get" class="searchform" action="/" role="search">
                        <div class="flex-row relative">
                            <div class="flex-col flex-grow">
                                <input type="search" class="search-field mb-0" name="s" value="" id="s" placeholder="Search&hellip;" />
                            </div>
                            <div class="flex-col">
                                <button type="submit" class="ux-search-submit submit-button secondary button icon mb-0" aria-label="Submit">
                                    <i class="icon-search"></i>
                                </button>
                            </div>
                        </div>
                        <div class="live-search-results text-left z-top"></div>
                    </form>
                </div>
            </div>
        </li>
        <li class="menu-item menu-item-type-custom menu-item-object-custom current-menu-item current_page_item menu-item-home menu-item-7"><a href="/" aria-current="page">Trang chủ</a></li>
        <li class="menu-item menu-item-type-post_type menu-item-object-page menu-item-214"><a href="/gioi-thieu">Giới thiệu</a></li>
        <li class="menu-item menu-item-type-custom menu-item-object-custom menu-item-has-children menu-item-9">
            <a href="/dich-vu">Dịch vụ</a>
            <ul class="sub-menu nav-sidebar-ul children">
                @foreach (var item in Model)
                {
                    <li class="menu-item menu-item-type-post_type menu-item-object-page menu-item-5173"><a href="/@item.LinkSeo">@item.Name</a></li>
                } 
            </ul>
        </li>
        <li class="menu-item menu-item-type-custom menu-item-object-custom menu-item-12"><a href="/tin-tuc">Tin tức</a></li>
        <li class="menu-item menu-item-type-post_type menu-item-object-page menu-item-525"><a href="/lien-he">Liên hệ</a></li>
    </ul>
</div>




