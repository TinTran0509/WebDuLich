@using Web.Model.CustomModel
@{
    ViewBag.Title = "Pasosea - Asia Travel Expert";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<ProductModel> prodGroups = (List<ProductModel>)TempData["GroupTour"];
    List<ProductModel> prodPrivate = (List<ProductModel>)TempData["PrivateTour"];
}
@model List<Web.Model.News>

<div class="pt-80 md-pt-60 sm-pt-30 pb-45 border-edeae5">
    <div class="container">
        <h2 class="section-title">
            Viaje en <span>grupo</span>
        </h2>

        <div class="row">
            <!-- 9 item -->
            @foreach (var item in prodGroups)
            {
                <div class="col-sm-6 col-lg-4 mb-30">
                    <div class="bg-color-fffdfb box-shadow-1 position-relative h-100 pb-115">
                        <div class="position-relative">
                            <a href="tour/@item.LinkSeo">
                                <img class="w-100"
                                     src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E"
                                     alt="@item.Title" data-lazy-src="@item.Image">
                                <noscript>
                                    <img class="w-100"
                                         src="@item.Image"
                                         alt="@item.Title">
                                </noscript>
                            </a>
                            <div class="position-absolute fw-700 color-fff text-shadow-1 left-20 bottom-18">
                                10                        Días /
                                9                        Noches
                            </div>
                        </div>
                        <div class="pl-20 pr-20">
                            <h3 class="fsz-18 mt-18 mb-12">
                                <a href="tour/@item.LinkSeo" class="text-decoration-none">
                                    @item.Title
                                </a>
                            </h3>
                            <div class="fw-500 color-bd1e2d">
                                Japón
                            </div>
                            <div>
                                Tokio, Kioto, Kanazawa, Gero, Osaka
                            </div>
                        </div>

                        <div class="position-absolute left-0 right-0 bottom-18 ml-20 mr-20">
                            <div class="fsz-18 color-ffa534 text-right">
                                ★★★★
                            </div>
                            <hr class="mt-10 mb-15">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <span>Desde</span>
                                    <span class="fsz-18 fw-700 color-111">
                                        USD 3680
                                    </span>
                                </div>
                                <div>
                                    <a href="tour/@item.LinkSeo" class="d-inline-block">
                                        Detalle
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            } 
        </div>

        <div class="text-center">
            <a href="tours-en-grupo/index.html" class="btn-style">
                Ver más
            </a>
        </div>
    </div>
</div>

<div class="pt-80 md-pt-60 sm-pt-30 pb-45 border-edeae5">
    <div class="container">
