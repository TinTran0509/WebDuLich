    </div>
</div>

<div class="pt-80 md-pt-60 sm-pt-30 pb-15 border-edeae5">
    <div class="container">
        <h2 class="section-title">
            @Html.Raw(ViewBag.TravelDestinations)
        </h2> 
        <div class="row sm-ml--10 sm-mr--10">
            <!-- Vòng lặp chạy ở đây -->
            @foreach (var item in countries)
            {
                <div class="col-6 col-sm-4 col-lg-3 mb-30 sm-mb-20 sm-pl-10 sm-pr-10">
                    <div class="position-relative text-center">
                        <img class="w-100" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" alt="@item.Name" data-lazy-src="@item.Image"><noscript>
                        <img class="w-100" src="@item.Image" alt="@item.Name"></noscript>
                        <h3 class="fsz-24 sm-fsz-20 m-0 middle-block">
                            <a href="destination/visitar-japon/index.html" class="color-fff text-decoration-none">
                                @item.Name
                            </a>
                        </h3>
                    </div>
                </div>
            }  
        </div>

        <h2 class="section-title pt-5">
            @Html.Raw(ViewBag.OurSpecialists)
        </h2>

        <div class="row">
            @foreach (var item in userModels)
            {
                <div class="col-6 col-md-3 mb-30">
                    <div class="mw-150 center-block text-center">
                        <img class="brs-50pc" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E" alt="@item.FullName" data-lazy-src="@item.Photo">
                        <noscript>
                           <img class="brs-50pc" src="@item.Photo" alt="@item.FullName">
                        </noscript>
                        <h3 class="fsz-18 mt-18 mb-5">@item.FullName</h3>
                        <div>@item.Description</div>
                    </div>
                </div>
            } 
        </div>
    </div>
</div>

