<div class="bt-edeae5 overflow-hidden" id="highlight">
    <div class="container">
        <h2 class="section-title text-center mt-0">
            <span>
                @ViewBag.Destination
            </span>
        </h2>
        <div class="destination-slider position-relative sm-ml--50pc sm-mr--50pc">
            <div class="swiper" data-swiper='{"loop":"true","slidesPerView":"3","spaceBetween":"20","navigation": {"nextEl": ".destination-slider .swiper-button-next", "prevEl": ".destination-slider .swiper-button-prev"},"breakpoints":{"992":{"slidesPerView":"4","spaceBetween":"30"},}}'>
                <div class="swiper-wrapper">
                    @foreach (var item in locationTrans)
                    {
                        <div class="swiper-slide h-auto p-1">
                            <div class="h-100 bg-color-fffdfb box-shadow-1 position-relative pb-50">
                                <img class="w-100" src="@item.Image" alt="Kanazawa" data-lazy-src="@item.Image"><noscript><img class="w-100" src="@item.Image" alt="@item.Name"></noscript>
                                <div class="pl-20 pr-20">
                                    <h3 class="fsz-18 mt-18 mb-12">
                                        @item.Name
                                    </h3>
                                    <p>
                                        @item.Description
                                    </p>
                                    <div class="position-absolute left-20 bottom-30 w-35px border-bd1e2d"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="swiper-button-prev left--60"></div>
            <div class="swiper-button-next right--60"></div>
        </div>
    </div>
</div>

<div class="pt-45" id="itinerary">
    <div class="container">
        <div class="pt-30">
            <h2 style="display: block;" class="section-title fw-400 text-center">
                @Html.Raw(ViewBag.EstimatedPrice)
            </h2>
        </div>
        <div class="text-center">
            <div class="container frm-booking">
                <form method="POST" id="booking-form" class="js-show-loading-on-submit" action="Detail">
                    <div class="">
                        <div class="form-booking">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="item est-price">
                                        <label>@ViewBag.Package:</label>
                                        <div class="item-value">
                                            <select name="package_star" class="package-star">
                                                <option value=""></option>
                                                <option value="3">@ViewBag.Package 3 @ViewBag.Star</option>
                                                <option value="4">@ViewBag.Package 4 @ViewBag.Star</option>
                                                <option value="5">@ViewBag.Package 5 @ViewBag.Star</option>
                                                <option value="6">@ViewBag.Package @ViewBag.Plus</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div style="padding-top:20px" class="item est-price">
                                        <label><span class="asterisk">*</span> @ViewBag.NumberPas:</label>
                                        <div class="item-value">
                                            <input id="pax" type="number" name="pax" min="1" max="20" class="inp-pax" required />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="item est-price">
                                        <label>@ViewBag.TongUocTinh:</label>
                                        <div class="item-value total-est">
                                            USD 0
                                        </div>
                                    </div>
                                    <div class="item departure-date est-price pt-40">
                                        <label><span class="asterisk">*</span> @ViewBag.ArrivalDate:</label>
                                        <div style="padding-top:4px" class="item-value fcwp-container">
                                            <input type="text" id="datepicker" name="date_of_sale" class="datepicker" required
                                                   value="@ViewBag.SelectedDate"
                                                   placeholder="Seleccionar"
                                                   data-select="Seleccionar"
                                                   readonly data-start="" data-end="+2y" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="pt-30">
                        <div class="w-75px h-3px bg-color-bd1e2d center-block mb-30"></div>
                        <div class="row">
                            <div class="col-md-3 col-4 mb-20 pr-0">
                                <label><span class="asterisk">*</span> @ViewBag.DanhXung</label>
                                <select name="forms_of_address" required>
                                    <option value="">@ViewBag.Select</option>
                                    @Html.Raw(ViewBag.Title)
                                </select>
                            </div>
                            <div class="col-md-3 col-8 mb-20">
                                <label><span class="asterisk">*</span> @ViewBag.Name</label>
                                <input type="text" name="lm_first_name" required />
                            </div>
                            <div class="col-md-6 mb-20">
                                <label><span class="asterisk">*</span> @ViewBag.LastName (s)</label>
                                <input type="text" name="lm_last_name" required />
                            </div>
                            <div class="col-md-6 mb-20">
                                <label><span class="asterisk">*</span> Email</label>
                                <input type="email" name="lm_email" required />
                            </div>
                            <div class="col-md-6 mb-20">
                                <label><span class="asterisk">*</span> WhatsApp/Tel (ej.:  123456789)</label>
                                <input type="text" name="lm_phone" pattern="[0-9]+" placeholder="* @ViewBag.PlaceTel." required />

                            </div>
                            <div class="col-md-6 mb-20">
                                <label><span class="asterisk">*</span> @ViewBag.NgonNguUuTien</label>
                                <select name="language" required>
                                    <option value="">@ViewBag.Select</option>
                                    <option value="0">Português</option>
                                    <option value="1">Español</option>
                                    <option value="1">English</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-20">
                                <label>@ViewBag.DepartureCity</label>
                                <input type="text" name="departure_city" />
                            </div>
                            <div class="col-md-12 mb-20">
                                <label><span class="asterisk">*</span> @ViewBag.NotesAnd</label>
                                <textarea name="note" placeholder="* @ViewBag.PlaceNotes" required></textarea>
                            </div>
                        </div>
                        <div id="payment-section"></div>
                        <div class="text-center pt-15 d-flex justify-content-center align-items-center section-action">
                            <input type="hidden" id="_wpnonce" name="_wpnonce" value="42b09ed278" />
                            <input type="hidden" name="_wp_http_referer" value="" />
                            <input type="hidden" name="action" value="process_booking" />
                            <input type="hidden" name="type" value="group-tour" />
                            <input type="hidden" name="tour_id" value="24120" />
                            <input type="hidden" name="booking_type" value="normal" />
                            <input type="hidden" name="page_id" value="94879" />
                            <input type="hidden" name="total_est" class="total-est-input" value="" />
                            <input type="hidden" name="extra_est" class="extra-est-input" value="" />
                            <input type="hidden" name="deposit_est" class="deposit-est-input" value="" />
                            <input type="hidden" name="lang" value="es" />
                            <input type="text" name="lm_tour" autocomplete="off" tabindex="-1" aria-hidden="true" style="position:absolute; left:-9999px;" />
                            <input type="hidden" name="form_start_time" value="1787366857">
                            <input type="hidden" name="utm_source" id="utm_source">
                            <input type="hidden" name="utm_campaign" id="utm_campaign">
                            <input type="hidden" name="utm_location" id="utm_location">
                            <input type="hidden" name="utm_adgroup" id="utm_adgroup">
                            <input type="hidden" value="@ViewBag.BookingSuccess" id="bookingmessage">
                            <div class="btn-step btn-step-1">
                                <button type="submit" class="btn-style btn-has-loading">
                                    @ViewBag.YCBaoGia <span class="oc-spinner"></span>
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div> 
</div>

