                    </div>
                    <!-- Tour Type -->
                    <div class="meta-item">
                        <svg class="meta-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <!-- Người giữa -->
                            <circle cx="12" cy="7" r="3" />
