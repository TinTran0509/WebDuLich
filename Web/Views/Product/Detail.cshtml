@using Web.Model
@using Web.Model.CustomModel
@model ProductModel
@{
    ViewBag.TitlePage = Model.Title;
    ViewBag.Image = Model.Image;
    ViewBag.Url = Model.LinkSeo;
    Layout = "~/Views/Shared/_LayoutDetail.cshtml";
    List<LocationViewModel> locationTrans = (List<LocationViewModel>)TempData["Locations"];
    int destinations = locationTrans.Count();
    string locations = "";
    foreach (var item in locationTrans)
    {
        locations += locations.Equals("") ? item.Name : "<span class='fw-400 ml-5 mr-5'>➙</span>" + item.Name;
    }

    List<ProductModel> relates = (List<ProductModel>)TempData["Relates"];
    List<Itinerary> itineraries = (List<Itinerary>)TempData["Itineraries"];
}
 
<link href="~/Content/all.min.css" rel="stylesheet" />
<link href="~/Content/asset/prod_detail.css" rel="stylesheet" />
<div class="page-banner">
    <input type="hidden" id="massage_date" value="@ViewBag.MessageSelectDate" />
    <input type="hidden" id="massage_pack" value="@ViewBag.MessageSelectPackage" />
    <input type="hidden" id="json-package" value="@ViewBag.JsonPackage" />
    <picture>
        @*<source media="(max-width: 480px)" data-lazy-srcset="@Model.Image">
            <source media="(min-width: 481px)" data-lazy-srcset="@Model.Image">*@
        <img style="height:200px" src="@Model.Image"
             alt=""
             fetchpriority="high"
             decoding="async"
             class="banner-image"
             data-lazy-src="@Model.Image" />
        <noscript>
            <img src="@Model.Image" alt="" fetchpriority="high" decoding="async" class="banner-image" />
        </noscript>
    </picture>
    <input type="hidden" id="lang-code" value="@Model.LangCode" />
    <h1 class="banner-title">@Model.Title</h1>
    <ul class="oc-breadcrumbs">
        <li><a href="/" class="home">@ViewBag.HomePage</a></li>
        <li><span>@Model.Title</span></li>
    </ul>
</div>

