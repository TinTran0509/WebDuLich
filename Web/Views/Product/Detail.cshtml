                        </svg>
                        <div>
                            <span>@ViewBag.TourTypeDes</span>
                            <strong>@ViewBag.TourType</strong>
                        </div>
                    </div>
                    <!-- Transport -->
                    <div class="meta-item">
                        <svg class="bus-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="4" y="3" width="16" height="17" rx="3" />
                            <path d="M6 6h12v5H6z" />
                            <path d="M4 14h16" />
                            <circle cx="8" cy="19" r="1.5" />
                            <circle cx="16" cy="19" r="1.5" />
                            <path d="M6 12h2" />
                            <path d="M16 12h2" />
                        </svg>
                        <div>
                            <span>@ViewBag.Transport</span>
                            <strong>@ViewBag.Private/@ViewBag.Sharing</strong>
                        </div>
                    </div>
                    <!-- Meals -->
                    <div class="meta-item">
                        <svg class="meta-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M7 3v8M4 3v8a3 3 0 0 0 3 3v7M10 3v8" />
                            <path d="M17 3v18M17 3c2 0 3-1.5 3-4s-1-5-3-5" />
                        </svg>
                        <div>
                            <span>@ViewBag.Meals</span>
                            <strong>B - L</strong>
                        </div>
                    </div>
                </section> 
                <p class="intro">
                    @Model.Description
                </p> 
                <section class="content-grid">
                    <main class="itinerary"> 
                        <h2 class="section-title text-center mt-0">
                            <span>@ViewBag.Itinerary</span>
                        </h2>
                        <div style="text-align:left" class="oc-accordion oc-itinerary">
                            @foreach (var item in itineraries)
                            {
                                <div class="item">
                                    <h3 class="item-title">
                                        <font dir="auto" style="vertical-align: inherit"><font dir="auto" style="vertical-align: inherit">@item.Title</font></font>
                                    </h3>
                                    <div class="item-content" style="display: none">
                                        @Html.Raw(item.Contents)
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="included-grid">
                            <div class="included-box">
                                <div class="section-title">
                                    <h2>@ViewBag.Included</h2>
                                </div>
                                <ul>
                                    @Html.Raw(ViewBag.Includeds) 
                                </ul>
                            </div>
                            <div class="included-box excluded">
