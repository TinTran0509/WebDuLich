                    <!-- Duration -->
                    <div class="meta-item">
                        <svg class="meta-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 7v5l3.5 2" fill="none" stroke="currentColor"
